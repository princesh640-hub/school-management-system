{
  "name": "school-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-Grade School Management System Monorepo",
  "scripts": {
    "build": "turbo run build",
    "build:web": "pnpm --filter @school/shared-types --filter @school/validation --filter @school/api-client --filter @school/web build",
    "build:api": "pnpm --filter @school/shared-types build && pnpm --filter @school/validation build && pnpm --filter @school/api prisma:generate",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @school/api prisma:generate",
    "db:migrate": "pnpm --filter @school/api prisma:migrate",
    "db:studio": "pnpm --filter @school/api prisma:studio",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
