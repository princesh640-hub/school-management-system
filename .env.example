# ==============================================================================
# Enterprise School Management System - Environment Configuration Template
# ==============================================================================
# NOTE: Copy this file to .env and replace placeholders with real secure values.
# NEVER commit real credentials or production secrets to source control.

# Node Environment
NODE_ENV=development
TZ=UTC

# ------------------------------------------------------------------------------
# API Backend (NestJS + Fastify)
# ------------------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
API_PREFIX=api/v1
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# ------------------------------------------------------------------------------
# Web Frontend (Next.js 16)
# ------------------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="Enterprise School Management System"

# ------------------------------------------------------------------------------
# PostgreSQL 18 Database
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here
DB_NAME=school_management_db
DB_SCHEMA=public
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=${DB_SCHEMA}&sslmode=prefer"

# ------------------------------------------------------------------------------
# Redis (Caching, Queues, Rate Limiting)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_DB=0
REDIS_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}"

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long_here
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# Object Storage (MinIO / S3 Compatible)
# ------------------------------------------------------------------------------
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=your_minio_root_user_here
STORAGE_SECRET_KEY=your_minio_root_password_here
STORAGE_BUCKET_DOCUMENTS=school-documents
STORAGE_BUCKET_PHOTOS=school-photos
STORAGE_BUCKET_REPORTS=school-reports
STORAGE_PUBLIC_URL=http://localhost:9000

# ------------------------------------------------------------------------------
# Email / Notification Worker (Future Queues)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM="School Management <no-reply@school.edu>"

# ------------------------------------------------------------------------------
# Reverse Proxy & Domain
# ------------------------------------------------------------------------------
DOMAIN_NAME=school.local
SSL_CERT_PATH=/etc/nginx/certs/school.crt
SSL_KEY_PATH=/etc/nginx/certs/school.key

# ------------------------------------------------------------------------------
# Phase 4S: External Integrations & Webhooks
# ------------------------------------------------------------------------------
# Dedicated 32-byte or 64-char key for AES-256-GCM encryption of integration secrets
INTEGRATIONS_ENCRYPTION_KEY=replace_with_32_byte_or_strong_random_secret_string
WEBHOOK_SIGNING_SECRET=replace_with_webhook_hmac_signing_secret_for_outbound
DEFAULT_PAYMENT_GATEWAY=STRIPE
DEFAULT_SMS_PROVIDER=TWILIO
DEFAULT_LMS_PROVIDER=CANVAS
DEFAULT_BIOMETRIC_PROVIDER=ZKTECO

# ------------------------------------------------------------------------------
# Phase 4T: Production Hardening, Observability & Backups
# ------------------------------------------------------------------------------
LOG_LEVEL=info
ENABLE_SWAGGER=false
APP_CORRELATION_HEADER=x-correlation-id
BACKUP_DIR=./infrastructure/backups
BACKUP_RETENTION_DAYS=30
HEALTH_CHECK_TIMEOUT_MS=5000

