// ------------------------------------------------------------------------------
// Multi-Campus Organization Hierarchy
// Organization -> Campus -> AcademicYear -> Departments / Classes / Users
// ------------------------------------------------------------------------------

model Organization {
  id       String       @id @default(uuid())
  name     String
  code     String       @unique
  domain   String?
  logoUrl  String?
  currency String       @default("USD")
  timezone String       @default("UTC")
  address  String?
  city     String?
  country  String?
  phone    String?
  email    String?
  website  String?
  taxId    String?      @map("tax_id")
  status   RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  campuses                    Campus[]
  academicYears               AcademicYear[]
  users                       User[]
  roles                       Role[]
  departments                 Department[]
  designations                Designation[]
  auditLogs                   AuditLog[]
  systemSettings              SystemSetting[]
  admissionApplications       AdmissionApplication[]
  calendarEvents              AcademicCalendarEvent[]
  curricula                   Curriculum[]
  attendanceSessions          AttendanceSession[]
  attendanceLocks             AttendanceLock[]
  employeeAttendances         EmployeeAttendance[]
  attendanceCorrections       AttendanceCorrection[]
  leaveTypes                  LeaveType[]
  leaveBalances               LeaveBalance[]
  leaveApplications           LeaveApplication[]
  attendanceThresholds        AttendanceThreshold[]
  workingDayConfigs           WorkingDayConfig[]
  timetablePeriods            TimetablePeriod[]
  rooms                       Room[]
  timetableTemplates          TimetableTemplate[]
  timetableVersions           TimetableVersion[]
  schedulingConstraints       SchedulingConstraint[]
  schedulingRuns              SchedulingRun[]
  examTypes                   ExamType[]
  examSessions                ExamSession[]
  gradeScales                 GradeScale[]
  reportCardTemplates         ReportCardTemplate[]
  academicTranscripts         AcademicTranscript[]
  feeCategories               FeeCategory[]
  feeStructures               FeeStructure[]
  feeSchedules                FeeSchedule[]
  feeDiscounts                FeeDiscount[]
  feeInvoices                 FeeInvoice[]
  cashierShifts               CashierShift[]
  salaryStructures            SalaryStructure[]
  payrollPeriods              PayrollPeriod[]
  employeeLoans               EmployeeLoan[]
  libraries                   Library[]
  bookCategories              BookCategory[]
  publishers                  Publisher[]
  authors                     Author[]
  books                       Book[]
  libraryMembers              LibraryMember[]
  transportFacilities         TransportFacility[]
  vehicles                    Vehicle[]
  transportDrivers            TransportDriver[]
  transportAttendants         TransportAttendant[]
  routes                      Route[]
  studentTransportAssignments StudentTransportAssignment[]
  transportSchedules          TransportSchedule[]
  boardingEvents              BoardingEvent[]
  transportIncidents          TransportIncident[]
  vehicleMaintenances         VehicleMaintenance[]
  vehicleFuelRecords          VehicleFuelRecord[]
  hostels                     Hostel[]
  hostelAllocations           HostelAllocation[]
  hostelAttendances           HostelAttendance[]
  hostelWardens               HostelWarden[]
  hostelOutings               HostelOuting[]
  hostelVisitors              HostelVisitor[]
  hostelIncidents             HostelIncident[]
  hostelMaintenanceRequests   HostelMaintenanceRequest[]
  inventoryCategories         InventoryCategory[]
  unitsOfMeasure              UnitOfMeasure[]
  inventoryItems              InventoryItem[]
  stores                      Store[]
  inventoryMovements          InventoryMovement[]
  inventoryTransfers          InventoryTransfer[]
  stockTakes                  StockTake[]
  suppliers                   Supplier[]
  purchaseRequests            PurchaseRequest[]
  purchaseOrders              PurchaseOrder[]
  goodsReceipts               GoodsReceipt[]
  supplierInvoiceReferences   SupplierInvoiceReference[]
  announcements               Announcement[]
  communicationTemplates      CommunicationTemplate[]
  communicationCampaigns      CommunicationCampaign[]
  communicationAudiences      CommunicationAudience[]

  @@map("organizations")
}

model Campus {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  code           String
  address        String?
  city           String?
  country        String?
  isMainCampus   Boolean      @default(false) @map("is_main_campus")
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicYears          AcademicYear[]
  departments            Department[]
  classes                Class[]
  users                  User[]
  auditLogs              AuditLog[]
  admissionApplications  AdmissionApplication[]
  calendarEvents         AcademicCalendarEvent[]
  attendanceSessions     AttendanceSession[]
  attendanceLocks        AttendanceLock[]
  employeeAttendances    EmployeeAttendance[]
  attendanceCorrections  AttendanceCorrection[]
  leaveBalances          LeaveBalance[]
  leaveApplications      LeaveApplication[]
  attendanceThresholds   AttendanceThreshold[]
  workingDayConfigs      WorkingDayConfig[]
  timetablePeriods       TimetablePeriod[]
  rooms                  Room[]
  timetableTemplates     TimetableTemplate[]
  timetableVersions      TimetableVersion[]
  schedulingRuns         SchedulingRun[]
  examTypes              ExamType[]
  examSessions           ExamSession[]
  gradeScales            GradeScale[]
  reportCardTemplates    ReportCardTemplate[]
  feeCategories          FeeCategory[]
  feeSchedules           FeeSchedule[]
  feeDiscounts           FeeDiscount[]
  cashierShifts          CashierShift[]
  employeeProfiles       EmployeeProfile[]
  payrollPeriods         PayrollPeriod[]
  libraries              Library[]
  transportFacilities    TransportFacility[]
  hostels                Hostel[]
  stores                 Store[]
  purchaseRequests       PurchaseRequest[]
  purchaseOrders         PurchaseOrder[]
  announcements          Announcement[]
  communicationCampaigns CommunicationCampaign[]
  feeStructures          FeeStructure[]
  feeInvoices            FeeInvoice[]
  curricula              Curriculum[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("campuses")
}

model AcademicYear {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  campusId       String?      @map("campus_id")
  name           String // e.g. "2026-2027"
  startDate      DateTime     @map("start_date")
  endDate        DateTime     @map("end_date")
  isCurrent      Boolean      @default(false) @map("is_current")
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  organization                Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus                      Campus?                      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  terms                       Term[]
  enrollments                 Enrollment[]
  examSchedules               ExamSchedule[]
  feeInvoices                 FeeInvoice[]
  admissionApplications       AdmissionApplication[]
  calendarEvents              AcademicCalendarEvent[]
  curricula                   Curriculum[]
  subjectOfferings            SubjectOffering[]
  classTeacherAssignments     ClassTeacherAssignment[]
  attendanceSessions          AttendanceSession[]
  attendanceLocks             AttendanceLock[]
  timetableVersions           TimetableVersion[]
  examSessions                ExamSession[]
  feeStructures               FeeStructure[]
  feeSchedules                FeeSchedule[]
  studentTransportAssignments StudentTransportAssignment[]
  hostelAllocations           HostelAllocation[]

  @@index([organizationId, isCurrent])
  @@map("academic_years")
}

model Department {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  campusId       String       @map("campus_id")
  name           String
  code           String
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus            @relation(fields: [campusId], references: [id], onDelete: Cascade)
  designations Designation[]
  employees    EmployeeProfile[]
  subjects     Subject[]

  @@unique([campusId, code])
  @@map("departments")
}

// ------------------------------------------------------------------------------
// Identity & Fine-Grained RBAC
// User -> Role -> Permission -> Module -> Action
// ------------------------------------------------------------------------------

model User {
  id                  String       @id @default(uuid())
  organizationId      String       @map("organization_id")
  campusId            String?      @map("campus_id")
  email               String       @unique
  passwordHash        String       @map("password_hash")
  firstName           String       @map("first_name")
  lastName            String       @map("last_name")
  phone               String?
  avatarUrl           String?      @map("avatar_url")
  gender              Gender?
  isEmailVerified     Boolean      @default(false) @map("is_email_verified")
  lastLoginAt         DateTime?    @map("last_login_at")
  status              RecordStatus @default(ACTIVE)
  suspendedAt         DateTime?    @map("suspended_at")
  suspendedReason     String?      @map("suspended_reason")
  archivedAt          DateTime?    @map("archived_at")
  failedLoginAttempts Int          @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?    @map("locked_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  organization  Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus        Campus?                  @relation(fields: [campusId], references: [id], onDelete: SetNull)
  userRoles     UserRole[]
  userOverrides UserPermissionOverride[]
  sessions      UserSession[]

  studentProfile           StudentProfile?
  guardianProfile          GuardianProfile?
  teacherProfile           TeacherProfile?
  employeeProfile          EmployeeProfile?
  auditLogs                AuditLog[]
  notifications            Notification[]
  requestedCorrections     AttendanceCorrection[]    @relation("CorrectionRequester")
  reviewedCorrections      AttendanceCorrection[]    @relation("CorrectionReviewer")
  reviewedLeaves           LeaveApplication[]        @relation("LeaveReviewer")
  cashierShifts            CashierShift[]
  libraryMembers           LibraryMember[]
  announcements            Announcement[]
  communicationDeliveries  CommunicationDelivery[]
  communicationPreferences CommunicationPreference[]
  deviceRegistrations      DeviceRegistration[]

  @@index([organizationId, email])
  @@index([campusId])
  @@map("users")
}

model Role {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  code           String // e.g. "TEACHER", "PRINCIPAL"
  description    String?
  isSystem       Boolean      @default(false) @map("is_system")
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, code])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique // e.g. "students:read", "fees:create"
  module      String // e.g. "students", "fees"
  action      String // e.g. "read", "create"
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(uuid())
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model UserPermissionOverride {
  id           String  @id @default(uuid())
  userId       String  @map("user_id")
  permissionId String  @map("permission_id")
  isGranted    Boolean @default(true) @map("is_granted") // true = explicitly granted, false = explicitly revoked

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permission_overrides")
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String?   @map("refresh_token_hash")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  lastActiveAt     DateTime  @default(now()) @map("last_active_at")
  expiresAt        DateTime  @map("expires_at")
  isRevoked        Boolean   @default(false) @map("is_revoked")
  revokedAt        DateTime? @map("revoked_at")
  revokedReason    String?   @map("revoked_reason")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@map("user_sessions")
}

model Designation {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  departmentId   String?      @map("department_id")
  title          String
  code           String
  description    String?
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees    EmployeeProfile[]

  @@unique([organizationId, code])
  @@map("designations")
}

model Term {
  id             String       @id @default(uuid())
  academicYearId String       @map("academic_year_id")
  name           String
  code           String
  startDate      DateTime     @map("start_date")
  endDate        DateTime     @map("end_date")
  isCurrent      Boolean      @default(false) @map("is_current")
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  academicYear      AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  calendarEvents    AcademicCalendarEvent[]
  subjectOfferings  SubjectOffering[]
  timetableVersions TimetableVersion[]
  examSessions      ExamSession[]

  @@unique([academicYearId, code])
  @@map("academic_terms")
}

// ------------------------------------------------------------------------------
// People Domain Profiles
// ------------------------------------------------------------------------------

model StudentProfile {
  id                       String                 @id @default(uuid())
  userId                   String                 @unique @map("user_id")
  admissionNumber          String                 @unique @map("admission_number")
  admissionDate            DateTime               @map("admission_date")
  dateOfBirth              DateTime               @map("date_of_birth")
  bloodGroup               String?                @map("blood_group")
  emergencyContact         String?                @map("emergency_contact")
  nationalId               String?                @map("national_id")
  address                  String?
  previousSchool           String?                @map("previous_school")
  medicalNotes             String?                @map("medical_notes")
  emergencyContactName     String?                @map("emergency_contact_name")
  emergencyContactPhone    String?                @map("emergency_contact_phone")
  emergencyContactRelation String?                @map("emergency_contact_relation")
  lifecycleStatus          StudentLifecycleStatus @default(ACTIVE) @map("lifecycle_status")
  status                   RecordStatus           @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardians         StudentGuardian[]
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]
  examResults       ExamResult[]
  feeInvoices       FeeInvoice[]

  statusHistory          StudentStatusHistory[]
  transfers              StudentTransfer[]
  documents              StudentDocument[]
  alumniRecord           AlumniRecord?
  admissionApplication   AdmissionApplication?
  emergencyContacts      EmergencyContact[]
  overallResults         ExamOverallResult[]
  reportCards            ReportCard[]
  academicTranscripts    AcademicTranscript[]
  feeAssignments         StudentFeeAssignment[]
  feeDiscounts           FeeDiscount[]
  feeAdjustments         FeeAdjustment[]
  libraryMembers         LibraryMember[]
  transportAssignments   StudentTransportAssignment[]
  boardingEvents         BoardingEvent[]
  incidentStudents       IncidentStudent[]
  hostelAllocations      HostelAllocation[]
  hostelAttendances      HostelAttendance[]
  hostelOutings          HostelOuting[]
  hostelVisitors         HostelVisitor[]
  hostelIncidentStudents HostelIncidentStudent[]

  @@map("student_profiles")
}

model GuardianProfile {
  id           String       @id @default(uuid())
  userId       String       @unique @map("user_id")
  occupation   String?
  relationship String? // Father, Mother, Legal Guardian
  address      String?
  status       RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  students StudentGuardian[]

  @@map("guardian_profiles")
}

model StudentGuardian {
  id                 String  @id @default(uuid())
  studentId          String  @map("student_id")
  guardianId         String  @map("guardian_id")
  relationship       String?
  isPrimary          Boolean @default(false) @map("is_primary")
  isEmergencyContact Boolean @default(false) @map("is_emergency_contact")
  canPickup          Boolean @default(true) @map("can_pickup")

  student  StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian GuardianProfile @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@map("student_guardians")
}

model AdmissionApplication {
  id                 String            @id @default(uuid())
  organizationId     String            @map("organization_id")
  campusId           String            @map("campus_id")
  academicYearId     String            @map("academic_year_id")
  classId            String            @map("class_id")
  applicationNumber  String            @unique @map("application_number")
  applicationDate    DateTime          @default(now()) @map("application_date")
  firstName          String            @map("first_name")
  lastName           String            @map("last_name")
  gender             Gender
  dateOfBirth        DateTime          @map("date_of_birth")
  email              String?
  phone              String?
  address            String?
  previousSchool     String?           @map("previous_school")
  previousGrade      String?           @map("previous_grade")
  guardianName       String            @map("guardian_name")
  guardianRelation   String            @map("guardian_relation")
  guardianPhone      String            @map("guardian_phone")
  guardianEmail      String?           @map("guardian_email")
  guardianAddress    String?           @map("guardian_address")
  guardianOccupation String?           @map("guardian_occupation")
  status             ApplicationStatus @default(SUBMITTED)
  reviewNotes        String?           @map("review_notes")
  reviewedBy         String?           @map("reviewed_by")
  decisionDate       DateTime?         @map("decision_date")
  decisionReason     String?           @map("decision_reason")
  admittedStudentId  String?           @unique @map("admitted_student_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus          Campus            @relation(fields: [campusId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class           Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  admittedStudent StudentProfile?   @relation(fields: [admittedStudentId], references: [id], onDelete: SetNull)
  documents       StudentDocument[]

  @@index([organizationId, campusId, status])
  @@index([academicYearId, classId])
  @@map("admission_applications")
}

model StudentStatusHistory {
  id             String                  @id @default(uuid())
  studentId      String                  @map("student_id")
  previousStatus StudentLifecycleStatus? @map("previous_status")
  newStatus      StudentLifecycleStatus  @map("new_status")
  reason         String?
  changedBy      String?                 @map("changed_by")
  changedAt      DateTime                @default(now()) @map("changed_at")
  metadata       Json?

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, changedAt])
  @@map("student_status_history")
}

model StudentTransfer {
  id            String       @id @default(uuid())
  studentId     String       @map("student_id")
  type          TransferType
  fromCampusId  String?      @map("from_campus_id")
  toCampusId    String?      @map("to_campus_id")
  fromSectionId String?      @map("from_section_id")
  toSectionId   String?      @map("to_section_id")
  effectiveDate DateTime     @default(now()) @map("effective_date")
  reason        String?
  transferredBy String?      @map("transferred_by")
  createdAt     DateTime     @default(now()) @map("created_at")

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, effectiveDate])
  @@map("student_transfers")
}

model AlumniRecord {
  id                String   @id @default(uuid())
  studentId         String   @unique @map("student_id")
  graduationYear    Int      @map("graduation_year")
  graduationClass   String?  @map("graduation_class")
  finalGrade        String?  @map("final_grade")
  contactEmail      String?  @map("contact_email")
  contactPhone      String?  @map("contact_phone")
  currentOccupation String?  @map("current_occupation")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("alumni_records")
}

model EmergencyContact {
  id           String   @id @default(uuid())
  studentId    String   @map("student_id")
  name         String
  relationship String
  phone        String
  altPhone     String?  @map("alt_phone")
  priority     Int      @default(1)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, priority])
  @@map("emergency_contacts")
}

model StudentDocument {
  id                     String    @id @default(uuid())
  studentId              String?   @map("student_id")
  admissionApplicationId String?   @map("admission_application_id")
  documentType           String    @map("document_type")
  fileKey                String    @map("file_key")
  fileName               String    @map("file_name")
  mimeType               String    @map("mime_type")
  sizeInBytes            BigInt?   @map("size_in_bytes")
  verifiedAt             DateTime? @map("verified_at")
  verifiedBy             String?   @map("verified_by")
  notes                  String?
  uploadedBy             String?   @map("uploaded_by")
  createdAt              DateTime  @default(now()) @map("created_at")

  student              StudentProfile?       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  admissionApplication AdmissionApplication? @relation(fields: [admissionApplicationId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([admissionApplicationId])
  @@map("student_documents")
}

model TeacherProfile {
  id             String       @id @default(uuid())
  userId         String       @unique @map("user_id")
  employeeCode   String       @unique @map("employee_code")
  specialization String?
  qualification  String?
  joiningDate    DateTime     @map("joining_date")
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections                Section[]                @relation("ClassTeacher")
  subjectTeachers         SubjectTeacher[]
  subjectOfferings        SubjectOffering[]
  classTeacherAssignments ClassTeacherAssignment[]
  availabilities          TeacherAvailability[]
  timetableEntries        TimetableEntry[]
  examInvigilators        ExamInvigilator[]

  @@map("teacher_profiles")
}

model EmployeeProfile {
  id                       String                  @id @default(uuid())
  userId                   String                  @unique @map("user_id")
  departmentId             String?                 @map("department_id")
  designationId            String?                 @map("designation_id")
  campusId                 String?                 @map("campus_id")
  employeeCode             String                  @unique @map("employee_code")
  preferredName            String?                 @map("preferred_name")
  designation              String
  employmentType           EmploymentType          @default(FULL_TIME) @map("employment_type")
  lifecycleStatus          EmployeeLifecycleStatus @default(ACTIVE) @map("lifecycle_status")
  joiningDate              DateTime                @map("joining_date")
  confirmationDate         DateTime?               @map("confirmation_date")
  nationalId               String?                 @map("national_id")
  address                  String?
  emergencyContactName     String?                 @map("emergency_contact_name")
  emergencyContactPhone    String?                 @map("emergency_contact_phone")
  emergencyContactRelation String?                 @map("emergency_contact_relation")
  qualifications           String[]                @default([])
  experienceYears          Int?                    @default(0) @map("experience_years")
  skills                   String[]                @default([])
  reportingManagerId       String?                 @map("reporting_manager_id")
  salaryBase               Decimal?                @map("salary_base") @db.Decimal(12, 2)
  status                   RecordStatus            @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  user                          User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department                    Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationRel                Designation?               @relation(fields: [designationId], references: [id], onDelete: SetNull)
  campus                        Campus?                    @relation(fields: [campusId], references: [id], onDelete: SetNull)
  reportingManager              EmployeeProfile?           @relation("EmployeeManager", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  subordinates                  EmployeeProfile[]          @relation("EmployeeManager")
  payrollRecords                PayrollRecord[]
  attendances                   EmployeeAttendance[]
  leaveBalances                 LeaveBalance[]
  leaveApplications             LeaveApplication[]
  statusHistory                 EmployeeStatusHistory[]
  contracts                     EmploymentContract[]
  documents                     EmployeeDocument[]
  salaryAssignments             EmployeeSalaryAssignment[]
  salaryHistory                 SalaryHistory[]
  loans                         EmployeeLoan[]
  payrollEmployeeRecords        PayrollEmployeeRecord[]
  libraryMembers                LibraryMember[]
  transportDriverAssignments    TransportDriver[]
  transportAttendantAssignments TransportAttendant[]
  hostelWardens                 HostelWarden[]
  hostelMaintenanceAssignments  HostelMaintenanceRequest[]
  managedStores                 Store[]
  purchaseRequests              PurchaseRequest[]

  @@map("employee_profiles")
}

// ------------------------------------------------------------------------------
// Phase 4H: HR, Employees & Payroll Models
// ------------------------------------------------------------------------------

model EmployeeStatusHistory {
  id             String                   @id @default(uuid())
  employeeId     String                   @map("employee_id")
  previousStatus EmployeeLifecycleStatus? @map("previous_status")
  newStatus      EmployeeLifecycleStatus  @map("new_status")
  effectiveDate  DateTime                 @default(now()) @map("effective_date")
  reason         String?
  notes          String?
  changedBy      String?                  @map("changed_by")
  createdAt      DateTime                 @default(now()) @map("created_at")

  employee EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveDate])
  @@map("employee_status_history")
}

model EmploymentContract {
  id             String         @id @default(uuid())
  employeeId     String         @map("employee_id")
  contractNumber String         @unique @map("contract_number")
  contractType   EmploymentType @default(FULL_TIME) @map("contract_type")
  startDate      DateTime       @map("start_date") @db.Date
  endDate        DateTime?      @map("end_date") @db.Date
  terms          String?
  renewalDate    DateTime?      @map("renewal_date") @db.Date
  status         ContractStatus @default(ACTIVE)
  documentUrl    String?        @map("document_url")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  createdBy      String?        @map("created_by")

  employee EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
  @@map("employment_contracts")
}

model EmployeeDocument {
  id           String    @id @default(uuid())
  employeeId   String    @map("employee_id")
  title        String
  documentType String    @map("document_type") // CONTRACT, QUALIFICATION, IDENTITY, EXPERIENCE, APPOINTMENT_LETTER, DISCIPLINARY, OTHER
  fileUrl      String    @map("file_url")
  fileSize     Int?      @map("file_size")
  mimeType     String?   @map("mime_type")
  issueDate    DateTime? @map("issue_date") @db.Date
  expiryDate   DateTime? @map("expiry_date") @db.Date
  notes        String?
  uploadedBy   String?   @map("uploaded_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  employee EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, documentType])
  @@map("employee_documents")
}

model SalaryStructure {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String // e.g. "Standard Teaching Faculty Scale"
  code           String       @unique
  baseSalary     Decimal      @map("base_salary") @db.Decimal(12, 2)
  currency       String       @default("USD")
  frequency      String       @default("MONTHLY") // MONTHLY, BI_WEEKLY, ANNUAL
  description    String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  components   SalaryComponent[]
  assignments  EmployeeSalaryAssignment[]

  @@map("salary_structures")
}

model SalaryComponent {
  id                String                @id @default(uuid())
  salaryStructureId String                @map("salary_structure_id")
  name              String // e.g. "Housing Allowance", "Tax Deduction"
  type              SalaryComponentType // ALLOWANCE, DEDUCTION
  calculationType   SalaryCalculationType @default(FIXED) @map("calculation_type") // FIXED, PERCENTAGE_OF_BASE
  value             Decimal               @db.Decimal(12, 2)
  isTaxable         Boolean               @default(true) @map("is_taxable")
  status            RecordStatus          @default(ACTIVE)
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  @@map("salary_components")
}

model EmployeeSalaryAssignment {
  id                 String       @id @default(uuid())
  employeeId         String       @map("employee_id")
  salaryStructureId  String       @map("salary_structure_id")
  baseSalaryOverride Decimal?     @map("base_salary_override") @db.Decimal(12, 2)
  effectiveFrom      DateTime     @map("effective_from") @db.Date
  effectiveTo        DateTime?    @map("effective_to") @db.Date
  reason             String?
  authorizedBy       String?      @map("authorized_by")
  status             RecordStatus @default(ACTIVE)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  employee        EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
  @@map("employee_salary_assignments")
}

model SalaryHistory {
  id            String   @id @default(uuid())
  employeeId    String   @map("employee_id")
  oldBaseSalary Decimal? @map("old_base_salary") @db.Decimal(12, 2)
  newBaseSalary Decimal  @map("new_base_salary") @db.Decimal(12, 2)
  effectiveFrom DateTime @map("effective_from") @db.Date
  reason        String?
  authorizedBy  String?  @map("authorized_by")
  createdAt     DateTime @default(now()) @map("created_at")

  employee EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
  @@map("salary_history")
}

model PayrollPeriod {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  campusId       String?             @map("campus_id")
  name           String // e.g. "October 2026 Payroll"
  startDate      DateTime            @map("start_date") @db.Date
  endDate        DateTime            @map("end_date") @db.Date
  paymentDate    DateTime?           @map("payment_date") @db.Date
  status         PayrollPeriodStatus @default(DRAFT)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  runs         PayrollRun[]

  @@unique([organizationId, campusId, name])
  @@map("payroll_periods")
}

model PayrollRun {
  id              String           @id @default(uuid())
  payrollPeriodId String           @map("payroll_period_id")
  runNumber       String           @unique @map("run_number") // PAY-YYYY-XXXXX
  totalEmployees  Int              @default(0) @map("total_employees")
  totalGross      Decimal          @default(0) @map("total_gross") @db.Decimal(12, 2)
  totalDeductions Decimal          @default(0) @map("total_deductions") @db.Decimal(12, 2)
  totalNet        Decimal          @default(0) @map("total_net") @db.Decimal(12, 2)
  status          PayrollRunStatus @default(DRAFT)
  processedAt     DateTime?        @map("processed_at")
  processedBy     String?          @map("processed_by")
  approvedAt      DateTime?        @map("approved_at")
  approvedBy      String?          @map("approved_by")
  lockedAt        DateTime?        @map("locked_at")
  lockedBy        String?          @map("locked_by")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  payrollPeriod PayrollPeriod           @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  records       PayrollEmployeeRecord[]

  @@map("payroll_runs")
}

model PayrollEmployeeRecord {
  id                  String   @id @default(uuid())
  payrollRunId        String   @map("payroll_run_id")
  employeeId          String   @map("employee_id")
  baseSalary          Decimal  @map("base_salary") @db.Decimal(12, 2)
  totalAllowances     Decimal  @default(0) @map("total_allowances") @db.Decimal(12, 2)
  totalDeductions     Decimal  @default(0) @map("total_deductions") @db.Decimal(12, 2)
  grossSalary         Decimal  @map("gross_salary") @db.Decimal(12, 2)
  netSalary           Decimal  @map("net_salary") @db.Decimal(12, 2)
  attendanceDeduction Decimal  @default(0) @map("attendance_deduction") @db.Decimal(12, 2)
  leaveDeduction      Decimal  @default(0) @map("leave_deduction") @db.Decimal(12, 2)
  loanDeduction       Decimal  @default(0) @map("loan_deduction") @db.Decimal(12, 2)
  bonusAmount         Decimal  @default(0) @map("bonus_amount") @db.Decimal(12, 2)
  status              String   @default("CALCULATED") // CALCULATED, REVIEWED, APPROVED, PAID
  remarks             String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  payrollRun     PayrollRun          @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee       EmployeeProfile     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  earnings       PayrollEarning[]
  deductions     PayrollDeduction[]
  adjustments    PayrollAdjustment[]
  payslips       Payslip[]
  loanRepayments LoanRepayment[]

  @@unique([payrollRunId, employeeId])
  @@map("payroll_employee_records")
}

model PayrollEarning {
  id               String      @id @default(uuid())
  employeeRecordId String      @map("employee_record_id")
  title            String
  earningType      EarningType @default(BASE) @map("earning_type")
  amount           Decimal     @db.Decimal(12, 2)
  source           String? // e.g. "SalaryStructure", "Bonus", "Manual"
  createdAt        DateTime    @default(now()) @map("created_at")

  employeeRecord PayrollEmployeeRecord @relation(fields: [employeeRecordId], references: [id], onDelete: Cascade)

  @@map("payroll_earnings")
}

model PayrollDeduction {
  id               String        @id @default(uuid())
  employeeRecordId String        @map("employee_record_id")
  title            String
  deductionType    DeductionType @default(TAX) @map("deduction_type")
  amount           Decimal       @db.Decimal(12, 2)
  source           String? // e.g. "TaxRule", "LoanInstallment", "UnpaidLeave"
  createdAt        DateTime      @default(now()) @map("created_at")

  employeeRecord PayrollEmployeeRecord @relation(fields: [employeeRecordId], references: [id], onDelete: Cascade)

  @@map("payroll_deductions")
}

model PayrollAdjustment {
  id               String   @id @default(uuid())
  employeeRecordId String   @map("employee_record_id")
  amount           Decimal  @db.Decimal(12, 2)
  type             String // EARNING, DEDUCTION
  reason           String
  requestedBy      String?  @map("requested_by")
  approvedBy       String?  @map("approved_by")
  createdAt        DateTime @default(now()) @map("created_at")

  employeeRecord PayrollEmployeeRecord @relation(fields: [employeeRecordId], references: [id], onDelete: Cascade)

  @@map("payroll_adjustments")
}

model EmployeeLoan {
  id                  String     @id @default(uuid())
  organizationId      String     @map("organization_id")
  employeeId          String     @map("employee_id")
  loanNumber          String     @unique @map("loan_number") // LOAN-YYYY-XXXXX
  principalAmount     Decimal    @map("principal_amount") @db.Decimal(12, 2)
  repaymentTermMonths Int        @map("repayment_term_months")
  monthlyInstallment  Decimal    @map("monthly_installment") @db.Decimal(12, 2)
  totalRepaid         Decimal    @default(0) @map("total_repaid") @db.Decimal(12, 2)
  remainingBalance    Decimal    @map("remaining_balance") @db.Decimal(12, 2)
  issueDate           DateTime   @default(now()) @map("issue_date") @db.Date
  status              LoanStatus @default(PENDING)
  reason              String?
  approvedBy          String?    @map("approved_by")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  repayments   LoanRepayment[]

  @@map("employee_loans")
}

model LoanRepayment {
  id               String   @id @default(uuid())
  loanId           String   @map("loan_id")
  employeeRecordId String?  @map("employee_record_id")
  repaymentNumber  String   @unique @map("repayment_number") // REP-YYYY-XXXXX
  amount           Decimal  @db.Decimal(12, 2)
  paymentDate      DateTime @default(now()) @map("payment_date")
  repaymentMethod  String   @default("PAYROLL_DEDUCTION") @map("repayment_method")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")

  loan           EmployeeLoan           @relation(fields: [loanId], references: [id], onDelete: Cascade)
  employeeRecord PayrollEmployeeRecord? @relation(fields: [employeeRecordId], references: [id], onDelete: SetNull)

  @@map("loan_repayments")
}

model Payslip {
  id                      String   @id @default(uuid())
  payrollEmployeeRecordId String   @map("payroll_employee_record_id")
  payslipNumber           String   @unique @map("payslip_number") // PSL-YYYY-XXXXX
  month                   Int
  year                    Int
  grossPay                Decimal  @map("gross_pay") @db.Decimal(12, 2)
  totalDeductions         Decimal  @map("total_deductions") @db.Decimal(12, 2)
  netPay                  Decimal  @map("net_pay") @db.Decimal(12, 2)
  issueDate               DateTime @default(now()) @map("issue_date") @db.Date
  status                  String   @default("GENERATED") // GENERATED, SENT, VIEWED
  pdfUrl                  String?  @map("pdf_url")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  employeeRecord PayrollEmployeeRecord @relation(fields: [payrollEmployeeRecordId], references: [id], onDelete: Cascade)

  @@unique([payrollEmployeeRecordId])
  @@map("payslips")
}

// ------------------------------------------------------------------------------
// Academics Domain
// ------------------------------------------------------------------------------

model Class {
  id          String       @id @default(uuid())
  campusId    String       @map("campus_id")
  name        String // e.g. "Grade 10"
  code        String
  orderIndex  Int          @default(0) @map("order_index")
  nextClassId String?      @map("next_class_id")
  status      RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  campus                Campus                 @relation(fields: [campusId], references: [id], onDelete: Cascade)
  nextClass             Class?                 @relation("ClassProgression", fields: [nextClassId], references: [id], onDelete: SetNull)
  previousClasses       Class[]                @relation("ClassProgression")
  sections              Section[]
  admissionApplications AdmissionApplication[]
  curricula             Curriculum[]
  subjectOfferings      SubjectOffering[]
  examSchedules         ExamSchedule[]
  feeStructures         FeeStructure[]
  attendanceSessions    AttendanceSession[]

  @@unique([campusId, code])
  @@map("classes")
}

model Section {
  id             String       @id @default(uuid())
  classId        String       @map("class_id")
  classTeacherId String?      @map("class_teacher_id")
  name           String // e.g. "Section A"
  capacity       Int          @default(40)
  roomNumber     String?      @map("room_number")
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  class                   Class                    @relation(fields: [classId], references: [id], onDelete: Cascade)
  classTeacher            TeacherProfile?          @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  enrollments             Enrollment[]
  subjects                SubjectTeacher[]
  attendanceRecords       AttendanceRecord[]
  subjectOfferings        SubjectOffering[]
  classTeacherAssignments ClassTeacherAssignment[]
  attendanceSessions      AttendanceSession[]
  attendanceLocks         AttendanceLock[]
  timetableEntries        TimetableEntry[]
  examSchedules           ExamSchedule[]
  overallResults          ExamOverallResult[]

  @@unique([classId, name])
  @@map("sections")
}

model Subject {
  id           String          @id @default(uuid())
  name         String // e.g. "Mathematics"
  code         String          @unique
  shortName    String?         @map("short_name")
  category     SubjectCategory @default(CORE)
  departmentId String?         @map("department_id")
  isElective   Boolean         @default(false) @map("is_elective")
  creditHours  Decimal?        @map("credit_hours") @db.Decimal(4, 2)
  status       RecordStatus    @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  department            Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  subjectTeachers       SubjectTeacher[]
  examSchedules         ExamSchedule[]
  curriculumSubjects    CurriculumSubject[]
  subjectOfferings      SubjectOffering[]
  attendanceSessions    AttendanceSession[]
  timetableEntries      TimetableEntry[]
  schedulingConstraints SchedulingConstraint[]

  @@map("subjects")
}

model SubjectTeacher {
  id        String @id @default(uuid())
  subjectId String @map("subject_id")
  teacherId String @map("teacher_id")
  sectionId String @map("section_id")

  subject Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([subjectId, teacherId, sectionId])
  @@map("subject_teachers")
}

model Enrollment {
  id             String       @id @default(uuid())
  academicYearId String       @map("academic_year_id")
  studentId      String       @map("student_id")
  sectionId      String       @map("section_id")
  rollNumber     String?      @map("roll_number")
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  academicYear      AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  student           StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section           Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  courseEnrollments CourseEnrollment[]

  @@unique([academicYearId, studentId])
  @@index([academicYearId, sectionId])
  @@map("enrollments")
}

model AttendanceRecord {
  id        String           @id @default(uuid())
  studentId String           @map("student_id")
  sectionId String           @map("section_id")
  sessionId String?          @map("session_id")
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  source    AttendanceSource @default(MANUAL)
  remarks   String?
  isLocked  Boolean          @default(false) @map("is_locked")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  student     StudentProfile         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section     Section                @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  session     AttendanceSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  corrections AttendanceCorrection[]

  @@unique([studentId, date])
  @@index([sectionId, date])
  @@map("attendance_records")
}

// ------------------------------------------------------------------------------
// Examinations, Grading & Assessment Domain
// ------------------------------------------------------------------------------

model ExamType {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  campusId       String?      @map("campus_id")
  name           String // e.g. "Final Term Examination", "Unit Test"
  code           String // e.g. "FINAL", "MID_TERM", "UNIT_1"
  description    String?
  weight         Decimal?     @db.Decimal(5, 2) // Optional weighting e.g. 70%
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?        @relation(fields: [campusId], references: [id], onDelete: SetNull)
  sessions     ExamSession[]
  schedules    ExamSchedule[]

  @@unique([organizationId, campusId, code])
  @@map("exam_types")
}

model ExamSession {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  campusId       String?           @map("campus_id")
  academicYearId String            @map("academic_year_id")
  termId         String?           @map("term_id")
  examTypeId     String            @map("exam_type_id")
  name           String // e.g. "Annual Examination 2026-27"
  startDate      DateTime          @map("start_date")
  endDate        DateTime          @map("end_date")
  status         ExamSessionStatus @default(DRAFT)
  publishedAt    DateTime?         @map("published_at")
  publishedBy    String?           @map("published_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus?             @relation(fields: [campusId], references: [id], onDelete: SetNull)
  academicYear   AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term           Term?               @relation(fields: [termId], references: [id], onDelete: SetNull)
  examType       ExamType            @relation(fields: [examTypeId], references: [id], onDelete: Cascade)
  schedules      ExamSchedule[]
  overallResults ExamOverallResult[]
  reportCards    ReportCard[]

  @@index([organizationId, academicYearId, status])
  @@map("exam_sessions")
}

model AssessmentComponent {
  id             String                  @id @default(uuid())
  examScheduleId String                  @map("exam_schedule_id")
  name           String // e.g. "Theory Paper", "Lab Practical"
  componentType  AssessmentComponentType @default(THEORY) @map("component_type")
  maxMarks       Decimal                 @map("max_marks") @db.Decimal(5, 2)
  passingMarks   Decimal                 @map("passing_marks") @db.Decimal(5, 2)
  weight         Decimal?                @db.Decimal(5, 2) // Percentage weight in subject
  sequence       Int                     @default(1)
  status         RecordStatus            @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  examSchedule   ExamSchedule          @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  componentMarks MarksEntryComponent[]

  @@map("assessment_components")
}

model ExamSchedule {
  id             String       @id @default(uuid())
  academicYearId String       @map("academic_year_id")
  examSessionId  String?      @map("exam_session_id")
  examTypeId     String?      @map("exam_type_id")
  classId        String?      @map("class_id")
  sectionId      String?      @map("section_id")
  subjectId      String       @map("subject_id")
  roomId         String?      @map("room_id")
  name           String // e.g. "Mid-Term Exam 2026"
  examDate       DateTime     @map("exam_date")
  startTime      String       @map("start_time")
  endTime        String       @map("end_time")
  maxMarks       Decimal      @map("max_marks") @db.Decimal(5, 2)
  passingMarks   Decimal      @map("passing_marks") @db.Decimal(5, 2)
  status         RecordStatus @default(ACTIVE)
  instructions   String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  academicYear AcademicYear          @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  examSession  ExamSession?          @relation(fields: [examSessionId], references: [id], onDelete: SetNull)
  examType     ExamType?             @relation(fields: [examTypeId], references: [id], onDelete: SetNull)
  class        Class?                @relation(fields: [classId], references: [id], onDelete: SetNull)
  section      Section?              @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  subject      Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  room         Room?                 @relation(fields: [roomId], references: [id], onDelete: SetNull)
  components   AssessmentComponent[]
  invigilators ExamInvigilator[]
  examResults  ExamResult[]

  @@map("exam_schedules")
}

model ExamInvigilator {
  id             String   @id @default(uuid())
  examScheduleId String   @map("exam_schedule_id")
  teacherId      String   @map("teacher_id")
  roomId         String?  @map("room_id")
  role           String   @default("PRIMARY") // PRIMARY, ASSISTANT, RELIEVER
  assignedAt     DateTime @default(now()) @map("assigned_at")

  examSchedule ExamSchedule   @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  teacher      TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  room         Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([examScheduleId, teacherId])
  @@map("exam_invigilators")
}

model ExamResult {
  id             String           @id @default(uuid())
  examScheduleId String           @map("exam_schedule_id")
  studentId      String           @map("student_id")
  marksObtained  Decimal          @map("marks_obtained") @db.Decimal(5, 2)
  percentage     Decimal?         @db.Decimal(5, 2)
  grade          String?
  gradePoint     Decimal?         @map("grade_point") @db.Decimal(4, 2)
  isPassed       Boolean          @default(false) @map("is_passed")
  isAbsent       Boolean          @default(false) @map("is_absent")
  isExempt       Boolean          @default(false) @map("is_exempt")
  status         MarksEntryStatus @default(DRAFT)
  remarks        String?
  version        Int              @default(1)
  isLocked       Boolean          @default(false) @map("is_locked")
  submittedAt    DateTime?        @map("submitted_at")
  submittedBy    String?          @map("submitted_by")
  approvedAt     DateTime?        @map("approved_at")
  approvedBy     String?          @map("approved_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  examSchedule   ExamSchedule          @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  student        StudentProfile        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  componentMarks MarksEntryComponent[]
  corrections    MarksCorrection[]

  @@unique([examScheduleId, studentId])
  @@map("exam_results")
}

model MarksEntryComponent {
  id            String  @id @default(uuid())
  examResultId  String  @map("exam_result_id")
  componentId   String  @map("component_id")
  marksObtained Decimal @map("marks_obtained") @db.Decimal(5, 2)
  isAbsent      Boolean @default(false) @map("is_absent")
  remarks       String?

  examResult ExamResult          @relation(fields: [examResultId], references: [id], onDelete: Cascade)
  component  AssessmentComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([examResultId, componentId])
  @@map("marks_entry_components")
}

model MarksCorrection {
  id             String             @id @default(uuid())
  examResultId   String             @map("exam_result_id")
  originalMarks  Decimal            @map("original_marks") @db.Decimal(5, 2)
  requestedMarks Decimal            @map("requested_marks") @db.Decimal(5, 2)
  reason         String
  requestedBy    String             @map("requested_by")
  status         CorrectionDecision @default(PENDING)
  reviewedBy     String?            @map("reviewed_by")
  reviewedAt     DateTime?          @map("reviewed_at")
  reviewRemarks  String?            @map("review_remarks")
  createdAt      DateTime           @default(now()) @map("created_at")

  examResult ExamResult @relation(fields: [examResultId], references: [id], onDelete: Cascade)

  @@index([examResultId, status])
  @@map("marks_corrections")
}

model GradeScale {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  campusId       String?      @map("campus_id")
  name           String // e.g. "Standard 10-Point Scale", "Letter Grade Scale"
  code           String // e.g. "STANDARD_10", "LETTER_GRADE"
  description    String?
  isDefault      Boolean      @default(false) @map("is_default")
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?          @relation(fields: [campusId], references: [id], onDelete: SetNull)
  rules        GradeScaleRule[]

  @@unique([organizationId, campusId, code])
  @@map("grade_scales")
}

model GradeScaleRule {
  id            String   @id @default(uuid())
  gradeScaleId  String   @map("grade_scale_id")
  grade         String // e.g. "A+", "A", "B"
  minPercentage Decimal  @map("min_percentage") @db.Decimal(5, 2)
  maxPercentage Decimal  @map("max_percentage") @db.Decimal(5, 2)
  gradePoint    Decimal? @map("grade_point") @db.Decimal(4, 2) // e.g. 4.0, 3.5
  description   String? // e.g. "Outstanding", "Excellent"
  isPass        Boolean  @default(true) @map("is_pass")
  sequence      Int      @default(1)

  gradeScale GradeScale @relation(fields: [gradeScaleId], references: [id], onDelete: Cascade)

  @@index([gradeScaleId, sequence])
  @@map("grade_scale_rules")
}

model ExamOverallResult {
  id                 String       @id @default(uuid())
  examSessionId      String       @map("exam_session_id")
  studentId          String       @map("student_id")
  sectionId          String       @map("section_id")
  totalMarksObtained Decimal      @map("total_marks_obtained") @db.Decimal(7, 2)
  totalMaxMarks      Decimal      @map("total_max_marks") @db.Decimal(7, 2)
  percentage         Decimal      @db.Decimal(5, 2)
  grade              String?
  gpa                Decimal?     @db.Decimal(4, 2)
  resultStatus       ResultStatus @default(PASS) @map("result_status")
  rank               Int?
  version            Int          @default(1)
  isLocked           Boolean      @default(false) @map("is_locked")
  isPublished        Boolean      @default(false) @map("is_published")
  publishedAt        DateTime?    @map("published_at")
  publishedBy        String?      @map("published_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  examSession ExamSession    @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section     Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([examSessionId, studentId])
  @@index([examSessionId, sectionId])
  @@map("exam_overall_results")
}

model ReportCardTemplate {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  campusId       String?      @map("campus_id")
  name           String // e.g. "Standard Term Report Card"
  code           String
  config         Json // Layout configuration, letterhead, signatures
  isDefault      Boolean      @default(false) @map("is_default")
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  reportCards  ReportCard[]

  @@unique([organizationId, campusId, code])
  @@map("report_card_templates")
}

model ReportCard {
  id                   String    @id @default(uuid())
  examSessionId        String    @map("exam_session_id")
  studentId            String    @map("student_id")
  templateId           String?   @map("template_id")
  issueDate            DateTime  @default(now()) @map("issue_date")
  attendancePercentage Decimal?  @map("attendance_percentage") @db.Decimal(5, 2)
  daysPresent          Int?      @map("days_present")
  daysAbsent           Int?      @map("days_absent")
  teacherRemarks       String?   @map("teacher_remarks")
  principalRemarks     String?   @map("principal_remarks")
  isPublished          Boolean   @default(false) @map("is_published")
  publishedAt          DateTime? @map("published_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  examSession ExamSession         @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  student     StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  template    ReportCardTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([examSessionId, studentId])
  @@map("report_cards")
}

model AcademicTranscript {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  studentId      String   @map("student_id")
  issueDate      DateTime @default(now()) @map("issue_date")
  cumulativeGpa  Decimal? @map("cumulative_gpa") @db.Decimal(4, 2)
  totalCredits   Decimal? @map("total_credits") @db.Decimal(5, 2)
  overallOutcome String?  @map("overall_outcome") // e.g. "Graduated with High Honors"
  transcriptData Json     @map("transcript_data") // Historical years, terms, subjects, grades
  issuedBy       String?  @map("issued_by")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([organizationId, studentId])
  @@map("academic_transcripts")
}

// ------------------------------------------------------------------------------
// Finance Domain
// ------------------------------------------------------------------------------

model FeeCategory {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  campusId       String?      @map("campus_id")
  name           String // e.g. "Tuition", "Laboratory", "Transport"
  code           String // e.g. "TUITION", "LAB", "BUS"
  description    String?
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?        @relation(fields: [campusId], references: [id], onDelete: SetNull)
  structures   FeeStructure[]
  discounts    FeeDiscount[]

  @@unique([organizationId, campusId, code])
  @@map("fee_categories")
}

model FeeStructure {
  id             String       @id @default(uuid())
  organizationId String?      @map("organization_id")
  campusId       String       @map("campus_id")
  feeCategoryId  String?      @map("fee_category_id")
  academicYearId String?      @map("academic_year_id")
  classId        String?      @map("class_id")
  name           String // e.g. "Tuition Fee - Grade 10"
  amount         Decimal      @db.Decimal(12, 2)
  frequency      String // MONTHLY, QUARTERLY, ANNUALLY, ONE_TIME
  description    String?
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization          Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  campus                Campus                 @relation(fields: [campusId], references: [id], onDelete: Cascade)
  feeCategory           FeeCategory?           @relation(fields: [feeCategoryId], references: [id], onDelete: SetNull)
  academicYear          AcademicYear?          @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  class                 Class?                 @relation(fields: [classId], references: [id], onDelete: SetNull)
  feeInvoices           FeeInvoice[]
  studentFeeAssignments StudentFeeAssignment[]
  feeSchedules          FeeSchedule[]

  @@map("fee_structures")
}

model FeeSchedule {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  campusId       String?      @map("campus_id")
  academicYearId String       @map("academic_year_id")
  feeStructureId String       @map("fee_structure_id")
  name           String // e.g. "Term 1 Billing", "October 2026 Tuition"
  billingDate    DateTime     @map("billing_date")
  dueDate        DateTime     @map("due_date")
  lateFeeType    LateFeeType  @default(FIXED) @map("late_fee_type")
  lateFeeValue   Decimal      @default(0) @map("late_fee_value") @db.Decimal(12, 2)
  graceDays      Int          @default(0) @map("grace_days")
  maxLateFee     Decimal?     @map("max_late_fee") @db.Decimal(12, 2)
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@index([organizationId, campusId, academicYearId])
  @@map("fee_schedules")
}

model StudentFeeAssignment {
  id             String       @id @default(uuid())
  studentId      String       @map("student_id")
  feeStructureId String       @map("fee_structure_id")
  customAmount   Decimal?     @map("custom_amount") @db.Decimal(12, 2)
  reason         String?
  authorizedBy   String?      @map("authorized_by")
  effectiveFrom  DateTime     @default(now()) @map("effective_from")
  effectiveTo    DateTime?    @map("effective_to")
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure   @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@unique([studentId, feeStructureId])
  @@map("student_fee_assignments")
}

model FeeDiscount {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  campusId       String?      @map("campus_id")
  feeCategoryId  String?      @map("fee_category_id")
  studentId      String?      @map("student_id")
  name           String // e.g. "Merit Scholarship 50%", "Sibling Concession"
  discountType   DiscountType @default(PERCENTAGE) @map("discount_type")
  value          Decimal      @db.Decimal(12, 2)
  reason         String?
  startDate      DateTime?    @map("start_date")
  endDate        DateTime?    @map("end_date")
  isApproved     Boolean      @default(true) @map("is_approved")
  approvedBy     String?      @map("approved_by")
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?         @relation(fields: [campusId], references: [id], onDelete: SetNull)
  feeCategory  FeeCategory?    @relation(fields: [feeCategoryId], references: [id], onDelete: SetNull)
  student      StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([organizationId, campusId])
  @@map("fee_discounts")
}

model FeeInvoice {
  id             String        @id @default(uuid())
  organizationId String?       @map("organization_id")
  campusId       String?       @map("campus_id")
  academicYearId String        @map("academic_year_id")
  studentId      String        @map("student_id")
  feeStructureId String        @map("fee_structure_id")
  invoiceNumber  String        @unique @map("invoice_number")
  subtotal       Decimal?      @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  fineAmount     Decimal       @default(0) @map("fine_amount") @db.Decimal(12, 2)
  amount         Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  dueDate        DateTime      @map("due_date")
  issuedDate     DateTime      @default(now()) @map("issued_date")
  status         InvoiceStatus @default(PENDING)
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  campus       Campus?              @relation(fields: [campusId], references: [id], onDelete: SetNull)
  academicYear AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  student      StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure         @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  payments     PaymentTransaction[]
  items        InvoiceItem[]
  refunds      PaymentRefund[]
  adjustments  FeeAdjustment[]
  installments FeeInstallment[]

  @@index([studentId, status])
  @@map("fee_invoices")
}

model InvoiceItem {
  id           String  @id @default(uuid())
  feeInvoiceId String  @map("fee_invoice_id")
  description  String // e.g. "Tuition Fee - Month 1", "Laboratory Charges", "Late Payment Fine"
  amount       Decimal @db.Decimal(12, 2)
  quantity     Int     @default(1)
  itemType     String  @default("FEE") @map("item_type") // FEE, DISCOUNT, FINE, ADJUSTMENT

  createdAt DateTime @default(now()) @map("created_at")

  feeInvoice FeeInvoice @relation(fields: [feeInvoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model PaymentTransaction {
  id              String        @id @default(uuid())
  feeInvoiceId    String        @map("fee_invoice_id")
  amount          Decimal       @db.Decimal(12, 2)
  paymentDate     DateTime      @default(now()) @map("payment_date")
  paymentMethod   PaymentMethod @default(CASH) @map("payment_method")
  referenceNumber String?       @map("reference_number")
  receiptNumber   String        @unique @map("receipt_number")
  idempotencyKey  String?       @unique @map("idempotency_key")
  status          PaymentStatus @default(PAID)
  remarks         String?
  cashierShiftId  String?       @map("cashier_shift_id")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  feeInvoice   FeeInvoice      @relation(fields: [feeInvoiceId], references: [id], onDelete: Cascade)
  cashierShift CashierShift?   @relation(fields: [cashierShiftId], references: [id], onDelete: SetNull)
  refunds      PaymentRefund[]

  @@map("payment_transactions")
}

model PaymentRefund {
  id                   String        @id @default(uuid())
  paymentTransactionId String        @map("payment_transaction_id")
  feeInvoiceId         String        @map("fee_invoice_id")
  amount               Decimal       @db.Decimal(12, 2)
  reason               String
  status               RefundStatus  @default(PENDING)
  requestedBy          String        @map("requested_by")
  approvedBy           String?       @map("approved_by")
  approvedAt           DateTime?     @map("approved_at")
  refundMethod         PaymentMethod @default(CASH) @map("refund_method")
  referenceNumber      String?       @map("reference_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  paymentTransaction PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)
  feeInvoice         FeeInvoice         @relation(fields: [feeInvoiceId], references: [id], onDelete: Cascade)

  @@index([feeInvoiceId, status])
  @@map("payment_refunds")
}

model FeeAdjustment {
  id             String         @id @default(uuid())
  feeInvoiceId   String         @map("fee_invoice_id")
  studentId      String         @map("student_id")
  adjustmentType AdjustmentType @default(CORRECTION) @map("adjustment_type")
  amount         Decimal        @db.Decimal(12, 2)
  reason         String
  authorizedBy   String         @map("authorized_by")

  createdAt DateTime @default(now()) @map("created_at")

  feeInvoice FeeInvoice     @relation(fields: [feeInvoiceId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([feeInvoiceId, studentId])
  @@map("fee_adjustments")
}

model FeeInstallment {
  id           String        @id @default(uuid())
  feeInvoiceId String        @map("fee_invoice_id")
  sequence     Int // 1, 2, 3...
  amount       Decimal       @db.Decimal(12, 2)
  paidAmount   Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  dueDate      DateTime      @map("due_date")
  status       InvoiceStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  feeInvoice FeeInvoice @relation(fields: [feeInvoiceId], references: [id], onDelete: Cascade)

  @@unique([feeInvoiceId, sequence])
  @@map("fee_installments")
}

model CashierShift {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  campusId       String?      @map("campus_id")
  cashierId      String       @map("cashier_id")
  openingBalance Decimal      @default(0) @map("opening_balance") @db.Decimal(12, 2)
  closingBalance Decimal?     @map("closing_balance") @db.Decimal(12, 2)
  totalCollected Decimal      @default(0) @map("total_collected") @db.Decimal(12, 2)
  totalRefunded  Decimal      @default(0) @map("total_refunded") @db.Decimal(12, 2)
  openedAt       DateTime     @default(now()) @map("opened_at")
  closedAt       DateTime?    @map("closed_at")
  status         RecordStatus @default(ACTIVE)
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?              @relation(fields: [campusId], references: [id], onDelete: SetNull)
  cashier      User                 @relation(fields: [cashierId], references: [id], onDelete: Cascade)
  payments     PaymentTransaction[]

  @@index([organizationId, campusId, cashierId])
  @@map("cashier_shifts")
}

model PayrollRecord {
  id          String       @id @default(uuid())
  employeeId  String       @map("employee_id")
  month       Int
  year        Int
  basicSalary Decimal      @map("basic_salary") @db.Decimal(12, 2)
  allowances  Decimal      @default(0) @db.Decimal(12, 2)
  deductions  Decimal      @default(0) @db.Decimal(12, 2)
  netSalary   Decimal      @map("net_salary") @db.Decimal(12, 2)
  paymentDate DateTime?    @map("payment_date")
  status      RecordStatus @default(PENDING_APPROVAL)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  employee EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@map("payroll_records")
}

// ------------------------------------------------------------------------------
// Infrastructure, Auditing & Storage Metadata
// ------------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  campusId       String?  @map("campus_id")
  userId         String?  @map("user_id")
  action         String // e.g. "CREATE", "UPDATE", "DELETE"
  module         String // e.g. "students", "fees"
  resourceId     String?  @map("resource_id")
  oldValues      Json?    @map("old_values")
  newValues      Json?    @map("new_values")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, module, action])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model FileMetadata {
  id          String   @id @default(uuid())
  bucketName  String   @map("bucket_name")
  fileKey     String   @unique @map("file_key")
  fileName    String   @map("file_name")
  mimeType    String   @map("mime_type")
  sizeInBytes BigInt   @map("size_in_bytes")
  uploadedBy  String?  @map("uploaded_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([bucketName, uploadedBy])
  @@map("file_metadata")
}

model SystemSetting {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  key            String
  value          String
  description    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("system_settings")
}

model Notification {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  userId         String                @map("user_id")
  title          String
  message        String
  type           String                @default("INFO") // INFO, WARNING, ALERT, ACADEMIC, FEE
  priority       CommunicationPriority @default(NORMAL)
  category       String?
  isRead         Boolean               @default(false) @map("is_read")
  readAt         DateTime?             @map("read_at")
  linkUrl        String?               @map("link_url")
  campaignId     String?               @map("campaign_id")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

// ------------------------------------------------------------------------------
// Phase 4C: Academic Calendar & Events
// ------------------------------------------------------------------------------

model AcademicCalendarEvent {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  campusId       String?               @map("campus_id")
  academicYearId String                @map("academic_year_id")
  termId         String?               @map("term_id")
  title          String
  description    String?
  category       CalendarEventCategory @default(EVENT)
  startDate      DateTime              @map("start_date")
  endDate        DateTime              @map("end_date")
  isHoliday      Boolean               @default(false) @map("is_holiday")
  targetAudience EventAudience         @default(ALL) @map("target_audience")
  status         RecordStatus          @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term         Term?        @relation(fields: [termId], references: [id], onDelete: SetNull)

  @@index([organizationId, academicYearId])
  @@index([startDate, endDate])
  @@map("academic_calendar_events")
}

// ------------------------------------------------------------------------------
// Phase 4C: Curriculum & Subject Offerings
// ------------------------------------------------------------------------------

model Curriculum {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  campusId       String?      @map("campus_id")
  academicYearId String       @map("academic_year_id")
  classId        String       @map("class_id")
  name           String
  code           String
  version        String       @default("1.0")
  description    String?
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?             @relation(fields: [campusId], references: [id], onDelete: SetNull)
  academicYear AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class        Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjects     CurriculumSubject[]

  @@unique([academicYearId, classId, code])
  @@map("curricula")
}

model CurriculumSubject {
  id            String   @id @default(uuid())
  curriculumId  String   @map("curriculum_id")
  subjectId     String   @map("subject_id")
  isRequired    Boolean  @default(true) @map("is_required")
  creditHours   Decimal? @map("credit_hours") @db.Decimal(4, 2)
  weeklyPeriods Int      @default(3) @map("weekly_periods")
  orderIndex    Int      @default(0) @map("order_index")

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([curriculumId, subjectId])
  @@map("curriculum_subjects")
}

model SubjectOffering {
  id               String       @id @default(uuid())
  academicYearId   String       @map("academic_year_id")
  termId           String?      @map("term_id")
  classId          String       @map("class_id")
  sectionId        String       @map("section_id")
  subjectId        String       @map("subject_id")
  primaryTeacherId String?      @map("primary_teacher_id")
  weeklyPeriods    Int          @default(4) @map("weekly_periods")
  status           RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  academicYear      AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term              Term?              @relation(fields: [termId], references: [id], onDelete: SetNull)
  class             Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  section           Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject           Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  primaryTeacher    TeacherProfile?    @relation(fields: [primaryTeacherId], references: [id], onDelete: SetNull)
  courseEnrollments CourseEnrollment[]
  timetableEntries  TimetableEntry[]

  @@unique([academicYearId, sectionId, subjectId])
  @@map("subject_offerings")
}

model ClassTeacherAssignment {
  id             String       @id @default(uuid())
  sectionId      String       @map("section_id")
  teacherId      String       @map("teacher_id")
  academicYearId String       @map("academic_year_id")
  startDate      DateTime     @default(now()) @map("start_date")
  endDate        DateTime?    @map("end_date")
  isCurrent      Boolean      @default(true) @map("is_current")
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  section      Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher      TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([sectionId, isCurrent])
  @@index([teacherId, isCurrent])
  @@map("class_teacher_assignments")
}

model CourseEnrollment {
  id                String                 @id @default(uuid())
  enrollmentId      String                 @map("enrollment_id")
  subjectOfferingId String                 @map("subject_offering_id")
  status            CourseEnrollmentStatus @default(ACTIVE)
  effectiveDate     DateTime               @default(now()) @map("effective_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  enrollment      Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  subjectOffering SubjectOffering @relation(fields: [subjectOfferingId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, subjectOfferingId])
  @@map("course_enrollments")
}

// ------------------------------------------------------------------------------
// Phase 4D: Attendance & Leave Management
// ------------------------------------------------------------------------------

model AttendanceSession {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  campusId       String?               @map("campus_id")
  academicYearId String                @map("academic_year_id")
  classId        String                @map("class_id")
  sectionId      String                @map("section_id")
  date           DateTime              @db.Date
  sessionType    AttendanceSessionType @default(FULL_DAY) @map("session_type")
  subjectId      String?               @map("subject_id")
  isLocked       Boolean               @default(false) @map("is_locked")
  lockedAt       DateTime?             @map("locked_at")
  lockedBy       String?               @map("locked_by")
  status         RecordStatus          @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?            @relation(fields: [campusId], references: [id], onDelete: SetNull)
  academicYear AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class        Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  section      Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject      Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  records      AttendanceRecord[]

  @@unique([sectionId, date, sessionType])
  @@index([organizationId, campusId])
  @@map("attendance_sessions")
}

model EmployeeAttendance {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  campusId       String?          @map("campus_id")
  employeeId     String           @map("employee_id")
  date           DateTime         @db.Date
  status         AttendanceStatus @default(PRESENT)
  checkInTime    DateTime?        @map("check_in_time")
  checkOutTime   DateTime?        @map("check_out_time")
  source         AttendanceSource @default(MANUAL)
  remarks        String?
  isLocked       Boolean          @default(false) @map("is_locked")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?                @relation(fields: [campusId], references: [id], onDelete: SetNull)
  employee     EmployeeProfile        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  corrections  AttendanceCorrection[]

  @@unique([employeeId, date])
  @@index([organizationId, campusId, date])
  @@map("employee_attendances")
}

model AttendanceCorrection {
  id                   String               @id @default(uuid())
  organizationId       String               @map("organization_id")
  targetType           CorrectionTargetType @map("target_type")
  attendanceRecordId   String?              @map("attendance_record_id")
  employeeAttendanceId String?              @map("employee_attendance_id")
  originalStatus       AttendanceStatus     @map("original_status")
  requestedStatus      AttendanceStatus     @map("requested_status")
  reason               String
  status               CorrectionStatus     @default(PENDING)
  requesterId          String               @map("requester_id")
  reviewerId           String?              @map("reviewer_id")
  decisionReason       String?              @map("decision_reason")
  reviewedAt           DateTime?            @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attendanceRecord   AttendanceRecord?   @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)
  employeeAttendance EmployeeAttendance? @relation(fields: [employeeAttendanceId], references: [id], onDelete: SetNull)
  requester          User                @relation("CorrectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer           User?               @relation("CorrectionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  campus             Campus?             @relation(fields: [campusId], references: [id])
  campusId           String?

  @@index([organizationId, status])
  @@map("attendance_corrections")
}

model AttendanceLock {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  campusId       String?             @map("campus_id")
  academicYearId String?             @map("academic_year_id")
  scopeType      AttendanceLockScope @map("scope_type")
  targetDate     DateTime?           @map("target_date") @db.Date
  sectionId      String?             @map("section_id")
  month          Int?
  year           Int?
  isLocked       Boolean             @default(true) @map("is_locked")
  lockedBy       String              @map("locked_by")
  lockedAt       DateTime            @default(now()) @map("locked_at")
  unlockedBy     String?             @map("unlocked_by")
  unlockedAt     DateTime?           @map("unlocked_at")
  unlockReason   String?             @map("unlock_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?       @relation(fields: [campusId], references: [id], onDelete: SetNull)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  section      Section?      @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([organizationId, campusId])
  @@map("attendance_locks")
}

model LeaveType {
  id                 String       @id @default(uuid())
  organizationId     String       @map("organization_id")
  name               String // e.g. "Annual Leave", "Casual Leave", "Sick Leave"
  code               String // e.g. "ANNUAL", "CASUAL", "SICK"
  description        String?
  isPaid             Boolean      @default(true) @map("is_paid")
  defaultDaysPerYear Int          @default(10) @map("default_days_per_year")
  requiresDocument   Boolean      @default(false) @map("requires_document")
  status             RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveBalances     LeaveBalance[]
  leaveApplications LeaveApplication[]

  @@unique([organizationId, code])
  @@map("leave_types")
}

model LeaveBalance {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  employeeId     String  @map("employee_id")
  leaveTypeId    String  @map("leave_type_id")
  year           Int
  openingBalance Decimal @default(0) @map("opening_balance") @db.Decimal(5, 2)
  accrued        Decimal @default(0) @db.Decimal(5, 2)
  used           Decimal @default(0) @db.Decimal(5, 2)
  pending        Decimal @default(0) @db.Decimal(5, 2)
  closingBalance Decimal @default(0) @map("closing_balance") @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     EmployeeProfile           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType                 @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  transactions LeaveBalanceTransaction[]
  campus       Campus?                   @relation(fields: [campusId], references: [id])
  campusId     String?

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveBalanceTransaction {
  id              String               @id @default(uuid())
  leaveBalanceId  String               @map("leave_balance_id")
  transactionType LeaveTransactionType @map("transaction_type")
  amount          Decimal              @db.Decimal(5, 2)
  reason          String?
  applicationId   String?              @map("application_id")
  performedBy     String?              @map("performed_by")
  createdAt       DateTime             @default(now()) @map("created_at")

  leaveBalance LeaveBalance @relation(fields: [leaveBalanceId], references: [id], onDelete: Cascade)

  @@index([leaveBalanceId])
  @@map("leave_balance_transactions")
}

model LeaveApplication {
  id                    String                 @id @default(uuid())
  organizationId        String                 @map("organization_id")
  campusId              String?                @map("campus_id")
  employeeId            String                 @map("employee_id")
  leaveTypeId           String                 @map("leave_type_id")
  startDate             DateTime               @map("start_date") @db.Date
  endDate               DateTime               @map("end_date") @db.Date
  durationDays          Decimal                @map("duration_days") @db.Decimal(4, 1)
  reason                String
  supportingDocumentUrl String?                @map("supporting_document_url")
  status                LeaveApplicationStatus @default(SUBMITTED)
  reviewerId            String?                @map("reviewer_id")
  decisionNotes         String?                @map("decision_notes")
  reviewedAt            DateTime?              @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?         @relation(fields: [campusId], references: [id], onDelete: SetNull)
  employee     EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType       @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  reviewer     User?           @relation("LeaveReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([organizationId, employeeId, status])
  @@map("leave_applications")
}

model AttendanceThreshold {
  id                 String  @id @default(uuid())
  organizationId     String  @map("organization_id")
  campusId           String? @map("campus_id")
  minimumPercentage  Decimal @default(75.0) @map("minimum_percentage") @db.Decimal(5, 2)
  warningPercentage  Decimal @default(80.0) @map("warning_percentage") @db.Decimal(5, 2)
  criticalPercentage Decimal @default(70.0) @map("critical_percentage") @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@unique([organizationId, campusId])
  @@map("attendance_thresholds")
}

// ------------------------------------------------------------------------------
// Phase 4E: Timetable & Scheduling Subsystem
// ------------------------------------------------------------------------------

model WorkingDayConfig {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  campusId       String?   @map("campus_id")
  dayOfWeek      DayOfWeek @map("day_of_week")
  isWorking      Boolean   @default(true) @map("is_working")
  startTime      String?   @map("start_time")
  endTime        String?   @map("end_time")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@unique([organizationId, campusId, dayOfWeek])
  @@map("working_day_configs")
}

model TimetablePeriod {
  id              String       @id @default(uuid())
  organizationId  String       @map("organization_id")
  campusId        String?      @map("campus_id")
  name            String
  sequence        Int
  startTime       String       @map("start_time")
  endTime         String       @map("end_time")
  durationMinutes Int          @map("duration_minutes")
  periodType      PeriodType   @default(TEACHING) @map("period_type")
  status          RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus                Campus?               @relation(fields: [campusId], references: [id], onDelete: SetNull)
  entries               TimetableEntry[]
  roomAvailabilities    RoomAvailability[]
  teacherAvailabilities TeacherAvailability[]

  @@unique([organizationId, campusId, sequence])
  @@map("timetable_periods")
}

model Room {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  campusId       String?      @map("campus_id")
  name           String
  code           String
  building       String?
  floor          String?
  capacity       Int          @default(40)
  roomType       RoomType     @default(CLASSROOM) @map("room_type")
  facilities     String[]     @default([])
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus           Campus?            @relation(fields: [campusId], references: [id], onDelete: SetNull)
  availabilities   RoomAvailability[]
  entries          TimetableEntry[]
  examSchedules    ExamSchedule[]
  examInvigilators ExamInvigilator[]

  @@unique([organizationId, campusId, code])
  @@map("rooms")
}

model RoomAvailability {
  id          String    @id @default(uuid())
  roomId      String    @map("room_id")
  dayOfWeek   DayOfWeek @map("day_of_week")
  periodId    String?   @map("period_id")
  isAvailable Boolean   @default(true) @map("is_available")
  reason      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  room   Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  period TimetablePeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)

  @@index([roomId, dayOfWeek])
  @@map("room_availabilities")
}

model TeacherAvailability {
  id          String    @id @default(uuid())
  teacherId   String    @map("teacher_id")
  dayOfWeek   DayOfWeek @map("day_of_week")
  periodId    String?   @map("period_id")
  isAvailable Boolean   @default(true) @map("is_available")
  reason      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teacher TeacherProfile   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  period  TimetablePeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)

  @@index([teacherId, dayOfWeek])
  @@map("teacher_availabilities")
}

model TimetableTemplate {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  campusId       String?      @map("campus_id")
  name           String
  description    String?
  totalPeriods   Int          @default(8) @map("total_periods")
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@map("timetable_templates")
}

model TimetableVersion {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  campusId       String?         @map("campus_id")
  academicYearId String          @map("academic_year_id")
  termId         String?         @map("term_id")
  versionNumber  Int             @default(1) @map("version_number")
  name           String
  status         TimetableStatus @default(DRAFT)
  effectiveFrom  DateTime?       @map("effective_from") @db.Date
  effectiveTo    DateTime?       @map("effective_to") @db.Date
  publishedAt    DateTime?       @map("published_at")
  publishedBy    String?         @map("published_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus?          @relation(fields: [campusId], references: [id], onDelete: SetNull)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term           Term?            @relation(fields: [termId], references: [id], onDelete: SetNull)
  entries        TimetableEntry[]
  schedulingRuns SchedulingRun[]

  @@unique([academicYearId, campusId, versionNumber])
  @@index([organizationId, campusId, status])
  @@map("timetable_versions")
}

model TimetableEntry {
  id                 String    @id @default(uuid())
  timetableVersionId String    @map("timetable_version_id")
  dayOfWeek          DayOfWeek @map("day_of_week")
  periodId           String    @map("period_id")
  sectionId          String    @map("section_id")
  subjectOfferingId  String?   @map("subject_offering_id")
  subjectId          String    @map("subject_id")
  teacherId          String?   @map("teacher_id")
  roomId             String?   @map("room_id")
  isLocked           Boolean   @default(false) @map("is_locked")
  customNotes        String?   @map("custom_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  timetableVersion TimetableVersion @relation(fields: [timetableVersionId], references: [id], onDelete: Cascade)
  period           TimetablePeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  section          Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectOffering  SubjectOffering? @relation(fields: [subjectOfferingId], references: [id], onDelete: SetNull)
  subject          Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher          TeacherProfile?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  room             Room?            @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([timetableVersionId, dayOfWeek, periodId, sectionId])
  @@index([timetableVersionId, dayOfWeek, periodId, teacherId], map: "idx_tt_entry_version_dow_period_teacher")
  @@index([timetableVersionId, dayOfWeek, periodId, roomId], map: "idx_tt_entry_version_dow_period_room")
  @@map("timetable_entries")
}

model SchedulingConstraint {
  id                 String      @id @default(uuid())
  organizationId     String      @map("organization_id")
  subjectId          String      @map("subject_id")
  preferredRoomType  RoomType?   @map("preferred_room_type")
  maxConsecutive     Int         @default(2) @map("max_consecutive")
  requireConsecutive Boolean     @default(false) @map("require_consecutive")
  preferredDays      DayOfWeek[] @default([]) @map("preferred_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, subjectId])
  @@map("scheduling_constraints")
}

model SchedulingRun {
  id                 String              @id @default(uuid())
  organizationId     String              @map("organization_id")
  campusId           String?             @map("campus_id")
  timetableVersionId String?             @map("timetable_version_id")
  status             SchedulingRunStatus @default(SUCCESS)
  totalSlotsRequired Int                 @map("total_slots_required")
  slotsScheduled     Int                 @map("slots_scheduled")
  conflictsCount     Int                 @default(0) @map("conflicts_count")
  unscheduledCount   Int                 @default(0) @map("unscheduled_count")
  diagnostics        Json?
  startedAt          DateTime            @default(now()) @map("started_at")
  completedAt        DateTime?           @map("completed_at")
  initiatedBy        String?             @map("initiated_by")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus           Campus?           @relation(fields: [campusId], references: [id], onDelete: SetNull)
  timetableVersion TimetableVersion? @relation(fields: [timetableVersionId], references: [id], onDelete: SetNull)

  @@index([organizationId, campusId])
  @@map("scheduling_runs")
}

// ------------------------------------------------------------------------------
// Phase 4I: Library Management Models
// ------------------------------------------------------------------------------

model Library {
  id              String       @id @default(uuid())
  organizationId  String       @map("organization_id")
  campusId        String?      @map("campus_id")
  name            String
  code            String
  description     String?
  locationDetails String?      @map("location_details")
  status          RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?           @relation(fields: [campusId], references: [id], onDelete: SetNull)
  locations    LibraryLocation[]
  copies       BookCopy[]

  @@unique([organizationId, code])
  @@index([organizationId, campusId])
  @@map("libraries")
}

model LibraryLocation {
  id          String       @id @default(uuid())
  libraryId   String       @map("library_id")
  building    String?
  floor       String?
  room        String?
  section     String?
  shelf       String
  code        String
  description String?
  status      RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  library Library    @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  copies  BookCopy[]

  @@unique([libraryId, code])
  @@map("library_locations")
}

model BookCategory {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  code           String
  description    String?
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  books        Book[]

  @@unique([organizationId, code])
  @@map("book_categories")
}

model Publisher {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  contact        String?
  website        String?
  address        String?
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  books        Book[]
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@map("publishers")
}

model Author {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  alternateName  String?      @map("alternate_name")
  biography      String?
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bookAuthors  BookAuthor[]
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@map("authors")
}

model Book {
  id              String       @id @default(uuid())
  organizationId  String       @map("organization_id")
  categoryId      String?      @map("category_id")
  publisherId     String?      @map("publisher_id")
  title           String
  subtitle        String?
  isbn10          String?      @map("isbn_10")
  isbn13          String?      @map("isbn_13")
  edition         String?
  publicationYear Int?         @map("publication_year")
  language        String       @default("English")
  description     String?
  subject         String?
  coverImageUrl   String?      @map("cover_image_url")
  keywords        String[]     @default([])
  status          RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     BookCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  publisher    Publisher?           @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  authors      BookAuthor[]
  copies       BookCopy[]
  reservations LibraryReservation[]

  @@index([organizationId, title])
  @@index([organizationId, isbn13])
  @@map("books")
}

model BookAuthor {
  id       String  @id @default(uuid())
  bookId   String  @map("book_id")
  authorId String  @map("author_id")
  role     String? @default("AUTHOR")

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([bookId, authorId])
  @@map("book_authors")
}

model BookCopy {
  id              String         @id @default(uuid())
  bookId          String         @map("book_id")
  libraryId       String?        @map("library_id")
  locationId      String?        @map("location_id")
  accessionNumber String         @unique @map("accession_number")
  barcode         String?        @unique
  condition       CopyCondition  @default(GOOD)
  status          BookCopyStatus @default(AVAILABLE)
  acquisitionDate DateTime?      @map("acquisition_date")
  cost            Decimal?       @db.Decimal(10, 2)
  supplier        String?
  notes           String?
  isReplacementOf String?        @map("is_replacement_of")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  book     Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  library  Library?         @relation(fields: [libraryId], references: [id], onDelete: SetNull)
  location LibraryLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  loans    LibraryLoan[]

  @@index([bookId, status])
  @@index([accessionNumber])
  @@index([barcode])
  @@map("book_copies")
}

model LibraryMember {
  id                String              @id @default(uuid())
  organizationId    String              @map("organization_id")
  userId            String              @map("user_id")
  studentProfileId  String?             @map("student_profile_id")
  employeeProfileId String?             @map("employee_profile_id")
  membershipNumber  String              @unique @map("membership_number")
  memberType        LibraryMemberType   @default(STUDENT) @map("member_type")
  borrowingLimit    Int                 @default(2) @map("borrowing_limit")
  maxBorrowDays     Int                 @default(14) @map("max_borrow_days")
  startDate         DateTime            @default(now()) @map("start_date")
  endDate           DateTime?           @map("end_date")
  status            LibraryMemberStatus @default(ACTIVE)
  notes             String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentProfile  StudentProfile?      @relation(fields: [studentProfileId], references: [id], onDelete: SetNull)
  employeeProfile EmployeeProfile?     @relation(fields: [employeeProfileId], references: [id], onDelete: SetNull)
  loans           LibraryLoan[]
  reservations    LibraryReservation[]
  fines           LibraryFine[]

  @@unique([organizationId, userId])
  @@index([membershipNumber])
  @@map("library_members")
}

model LibraryLoan {
  id              String            @id @default(uuid())
  loanNumber      String            @unique @map("loan_number")
  copyId          String            @map("copy_id")
  memberId        String            @map("member_id")
  issueDate       DateTime          @default(now()) @map("issue_date")
  dueDate         DateTime          @map("due_date")
  returnDate      DateTime?         @map("return_date")
  returnCondition CopyCondition?    @map("return_condition")
  renewalCount    Int               @default(0) @map("renewal_count")
  status          LibraryLoanStatus @default(ACTIVE)
  issuedById      String?           @map("issued_by_id")
  returnedById    String?           @map("returned_by_id")
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  copy     BookCopy         @relation(fields: [copyId], references: [id], onDelete: Cascade)
  member   LibraryMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  renewals LibraryRenewal[]
  fines    LibraryFine[]

  @@index([copyId, status])
  @@index([memberId, status])
  @@index([dueDate, status])
  @@map("library_loans")
}

model LibraryRenewal {
  id              String   @id @default(uuid())
  loanId          String   @map("loan_id")
  previousDueDate DateTime @map("previous_due_date")
  newDueDate      DateTime @map("new_due_date")
  renewedAt       DateTime @default(now()) @map("renewed_at")
  renewedById     String?  @map("renewed_by_id")
  notes           String?

  loan LibraryLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@map("library_renewals")
}

model LibraryReservation {
  id                String                   @id @default(uuid())
  reservationNumber String                   @unique @map("reservation_number")
  bookId            String                   @map("book_id")
  memberId          String                   @map("member_id")
  reservationDate   DateTime                 @default(now()) @map("reservation_date")
  queuePosition     Int                      @default(1) @map("queue_position")
  expiryDate        DateTime?                @map("expiry_date")
  status            LibraryReservationStatus @default(PENDING)
  notes             String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  book   Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  member LibraryMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([bookId, status, queuePosition])
  @@index([memberId, status])
  @@map("library_reservations")
}

model LibraryFine {
  id                   String            @id @default(uuid())
  fineNumber           String            @unique @map("fine_number")
  loanId               String?           @map("loan_id")
  memberId             String            @map("member_id")
  amount               Decimal           @db.Decimal(10, 2)
  reason               String
  status               LibraryFineStatus @default(ASSESSED)
  assessedDate         DateTime          @default(now()) @map("assessed_date")
  paidDate             DateTime?         @map("paid_date")
  waivedDate           DateTime?         @map("waived_date")
  waivedById           String?           @map("waived_by_id")
  waiverReason         String?           @map("waiver_reason")
  financeTransactionId String?           @map("finance_transaction_id")
  notes                String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  loan   LibraryLoan?  @relation(fields: [loanId], references: [id], onDelete: SetNull)
  member LibraryMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, status])
  @@index([loanId])
  @@map("library_fines")
}

// ------------------------------------------------------------------------------
// Phase 4J: Transport Management Enums
// ------------------------------------------------------------------------------

enum VehicleStatus {
  ACTIVE
  IN_SERVICE
  MAINTENANCE
  OUT_OF_SERVICE
  RETIRED
  SOLD
  INACTIVE
}

enum VehicleType {
  BUS
  MINI_BUS
  VAN
  CAR
  BIKE
  OTHER
}

enum BoardingEventType {
  BOARDING
  DROPPED_OFF
  NO_SHOW
  LEFT_WITH_GUARDIAN
  OTHER
}

enum MaintenanceType {
  ROUTINE_SERVICE
  REPAIR
  INSPECTION
  TYRE
  OIL
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TransportAssignmentType {
  PICKUP
  DROP
  BOTH
}

enum TransportScheduleStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DELAYED
}

// ------------------------------------------------------------------------------
// Phase 4J: Transport Management Models
// ------------------------------------------------------------------------------

model TransportFacility {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  campusId       String?      @map("campus_id")
  name           String
  code           String
  address        String?
  city           String?
  contactPhone   String?      @map("contact_phone")
  contactEmail   String?      @map("contact_email")
  notes          String?
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  vehicles     Vehicle[]
  routes       Route[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("transport_facilities")
}

model Vehicle {
  id                 String        @id @default(uuid())
  organizationId     String        @map("organization_id")
  facilityId         String?       @map("facility_id")
  vehicleNumber      String        @unique @map("vehicle_number")
  registrationNumber String        @unique @map("registration_number")
  vehicleType        VehicleType   @default(BUS) @map("vehicle_type")
  make               String?
  model              String?
  year               Int?
  color              String?
  capacity           Int
  fuelType           String?       @map("fuel_type")
  engineNumber       String?       @map("engine_number")
  chassisNumber      String?       @map("chassis_number")
  insuranceNumber    String?       @map("insurance_number")
  insuranceExpiry    DateTime?     @map("insurance_expiry")
  fitnessExpiry      DateTime?     @map("fitness_expiry")
  taxExpiry          DateTime?     @map("tax_expiry")
  permitExpiry       DateTime?     @map("permit_expiry")
  gpsDeviceId        String?       @map("gps_device_id")
  lastServiceDate    DateTime?     @map("last_service_date")
  nextServiceDue     DateTime?     @map("next_service_due")
  odometer           Int?          @default(0)
  status             VehicleStatus @default(ACTIVE)
  notes              String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facility             TransportFacility?   @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  documents            VehicleDocument[]
  driverAssignments    TransportDriver[]
  attendantAssignments TransportAttendant[]
  schedules            TransportSchedule[]
  maintenances         VehicleMaintenance[]
  fuelRecords          VehicleFuelRecord[]
  incidents            TransportIncident[]
  boardingEvents       BoardingEvent[]

  @@index([organizationId, status])
  @@index([facilityId])
  @@map("vehicles")
}

model VehicleDocument {
  id           String       @id @default(uuid())
  vehicleId    String       @map("vehicle_id")
  title        String
  documentType String       @map("document_type")
  fileUrl      String?      @map("file_url")
  issueDate    DateTime?    @map("issue_date")
  expiryDate   DateTime?    @map("expiry_date")
  notes        String?
  status       RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_documents")
}

model TransportDriver {
  id              String       @id @default(uuid())
  organizationId  String       @map("organization_id")
  vehicleId       String?      @map("vehicle_id")
  employeeId      String?      @map("employee_id")
  driverCode      String       @unique @map("driver_code")
  licenseNumber   String       @unique @map("license_number")
  licenseExpiry   DateTime?    @map("license_expiry")
  licenseClass    String?      @map("license_class")
  experienceYears Int?         @default(0) @map("experience_years")
  contactPhone    String?      @map("contact_phone")
  address         String?
  notes           String?
  status          RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  employee     EmployeeProfile?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  schedules    TransportSchedule[]
  incidents    TransportIncident[]

  @@index([organizationId, status])
  @@map("transport_drivers")
}

model TransportAttendant {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  vehicleId      String?      @map("vehicle_id")
  employeeId     String?      @map("employee_id")
  attendantCode  String       @unique @map("attendant_code")
  contactPhone   String?      @map("contact_phone")
  address        String?
  notes          String?
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  employee     EmployeeProfile?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  schedules    TransportSchedule[]

  @@index([organizationId, status])
  @@map("transport_attendants")
}

model Route {
  id               String       @id @default(uuid())
  organizationId   String       @map("organization_id")
  facilityId       String?      @map("facility_id")
  routeCode        String       @unique @map("route_code")
  name             String
  description      String?
  startLocation    String?      @map("start_location")
  endLocation      String?      @map("end_location")
  totalDistance    Decimal?     @map("total_distance") @db.Decimal(8, 2)
  estimatedMinutes Int?         @map("estimated_minutes")
  feeAmount        Decimal?     @map("fee_amount") @db.Decimal(10, 2)
  feeStructureId   String?      @map("fee_structure_id")
  isActive         Boolean      @default(true) @map("is_active")
  status           RecordStatus @default(ACTIVE)
  notes            String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facility     TransportFacility?           @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  stops        RouteStop[]
  assignments  StudentTransportAssignment[]
  schedules    TransportSchedule[]

  @@index([organizationId, status])
  @@map("routes")
}

model RouteStop {
  id            String   @id @default(uuid())
  routeId       String   @map("route_id")
  stopName      String   @map("stop_name")
  stopOrder     Int      @map("stop_order")
  address       String?
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  pickupTime    String?  @map("pickup_time")
  dropTime      String?  @map("drop_time")
  landmarkNotes String?  @map("landmark_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  route          Route                        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  assignments    StudentTransportAssignment[]
  boardingEvents BoardingEvent[]

  @@index([routeId, stopOrder])
  @@map("route_stops")
}

model StudentTransportAssignment {
  id              String                  @id @default(uuid())
  organizationId  String                  @map("organization_id")
  studentId       String                  @map("student_id")
  routeId         String                  @map("route_id")
  stopId          String?                 @map("stop_id")
  academicYearId  String?                 @map("academic_year_id")
  assignmentType  TransportAssignmentType @default(BOTH) @map("assignment_type")
  pickupAddress   String?                 @map("pickup_address")
  dropAddress     String?                 @map("drop_address")
  guardianContact String?                 @map("guardian_contact")
  effectiveFrom   DateTime                @map("effective_from")
  effectiveTo     DateTime?               @map("effective_to")
  isActive        Boolean                 @default(true) @map("is_active")
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route        Route          @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop         RouteStop?     @relation(fields: [stopId], references: [id], onDelete: SetNull)
  academicYear AcademicYear?  @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  @@index([studentId, isActive])
  @@index([routeId, isActive])
  @@map("student_transport_assignments")
}

model TransportSchedule {
  id             String                  @id @default(uuid())
  organizationId String                  @map("organization_id")
  routeId        String                  @map("route_id")
  vehicleId      String?                 @map("vehicle_id")
  driverId       String?                 @map("driver_id")
  attendantId    String?                 @map("attendant_id")
  scheduleDate   DateTime                @map("schedule_date")
  departureTime  String?                 @map("departure_time")
  arrivalTime    String?                 @map("arrival_time")
  tripType       String                  @default("MORNING") @map("trip_type")
  status         TransportScheduleStatus @default(SCHEDULED)
  delayMinutes   Int?                    @default(0) @map("delay_minutes")
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  route          Route               @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicle        Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver         TransportDriver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  attendant      TransportAttendant? @relation(fields: [attendantId], references: [id], onDelete: SetNull)
  boardingEvents BoardingEvent[]

  @@index([organizationId, scheduleDate])
  @@index([routeId, scheduleDate])
  @@map("transport_schedules")
}

model BoardingEvent {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  scheduleId     String?           @map("schedule_id")
  vehicleId      String?           @map("vehicle_id")
  studentId      String            @map("student_id")
  stopId         String?           @map("stop_id")
  eventType      BoardingEventType @map("event_type")
  eventTime      DateTime          @default(now()) @map("event_time")
  recordedBy     String?           @map("recorded_by")
  guardianName   String?           @map("guardian_name")
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schedule     TransportSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  vehicle      Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  student      StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  stop         RouteStop?         @relation(fields: [stopId], references: [id], onDelete: SetNull)

  @@index([studentId, eventTime])
  @@index([scheduleId])
  @@map("boarding_events")
}

model TransportIncident {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  vehicleId      String?          @map("vehicle_id")
  driverId       String?          @map("driver_id")
  incidentNumber String           @unique @map("incident_number")
  incidentDate   DateTime         @map("incident_date")
  location       String?
  description    String
  severity       IncidentSeverity @default(LOW)
  reportedBy     String?          @map("reported_by")
  actionTaken    String?          @map("action_taken")
  isResolved     Boolean          @default(false) @map("is_resolved")
  resolvedAt     DateTime?        @map("resolved_at")
  resolvedBy     String?          @map("resolved_by")
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle          Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver           TransportDriver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  involvedStudents IncidentStudent[]

  @@index([organizationId, incidentDate])
  @@map("transport_incidents")
}

model IncidentStudent {
  id         String  @id @default(uuid())
  incidentId String  @map("incident_id")
  studentId  String  @map("student_id")
  notes      String?

  incident TransportIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  student  StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, studentId])
  @@map("incident_students")
}

model VehicleMaintenance {
  id                String          @id @default(uuid())
  organizationId    String          @map("organization_id")
  vehicleId         String          @map("vehicle_id")
  maintenanceNumber String          @unique @map("maintenance_number")
  maintenanceType   MaintenanceType @default(ROUTINE_SERVICE) @map("maintenance_type")
  scheduledDate     DateTime?       @map("scheduled_date")
  completedDate     DateTime?       @map("completed_date")
  description       String
  serviceProvider   String?         @map("service_provider")
  cost              Decimal?        @db.Decimal(10, 2)
  odometerAtService Int?            @map("odometer_at_service")
  nextServiceDue    DateTime?       @map("next_service_due")
  isCompleted       Boolean         @default(false) @map("is_completed")
  notes             String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, scheduledDate])
  @@map("vehicle_maintenances")
}

model VehicleFuelRecord {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  vehicleId      String   @map("vehicle_id")
  fuelDate       DateTime @map("fuel_date")
  liters         Decimal  @db.Decimal(8, 2)
  pricePerLiter  Decimal? @map("price_per_liter") @db.Decimal(8, 2)
  totalCost      Decimal? @map("total_cost") @db.Decimal(10, 2)
  odometer       Int?
  fuelStation    String?  @map("fuel_station")
  recordedBy     String?  @map("recorded_by")
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, fuelDate])
  @@index([organizationId, fuelDate])
  @@map("vehicle_fuel_records")
}

// ------------------------------------------------------------------------------
// Phase 4K: Hostel Management Enums
// ------------------------------------------------------------------------------

enum HostelStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  CLOSED
}

enum HostelType {
  BOYS
  GIRLS
  COED
  STAFF
  OTHER
}

enum HostelRoomType {
  DORMITORY
  SHARED_ROOM
  SINGLE_ROOM
  SPECIAL
  OTHER
}

enum HostelGenderEligibility {
  MALE
  FEMALE
  ANY
}

enum HostelRoomStatus {
  AVAILABLE
  FULL
  MAINTENANCE
  INACTIVE
}

enum HostelBedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
  BLOCKED
  RETIRED
}

enum HostelAllocationStatus {
  RESERVED
  ACTIVE
  TRANSFERRED
  CHECKED_OUT
  CANCELLED
}

enum HostelAttendanceStatus {
  PRESENT
  ABSENT
  OUT
  LATE
  EXCUSED
  OTHER
}

enum HostelStaffRole {
  WARDEN
  ASSISTANT_WARDEN
  CARETAKER
  SUPERVISOR
  OTHER
}

enum HostelOutingStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  OUT
  RETURNED
  CANCELLED
  LATE_RETURN
}

enum HostelOutingType {
  DAY_OUTING
  OVERNIGHT
  WEEKEND
  EMERGENCY
  OTHER
}

enum HostelMaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum HostelMaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

enum HostelVisitorStatus {
  SCHEDULED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum HostelIncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

// ------------------------------------------------------------------------------
// Phase 4K: Hostel Management Models
// ------------------------------------------------------------------------------

model Hostel {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  campusId       String?      @map("campus_id")
  name           String
  code           String       @unique
  hostelType     HostelType   @default(COED) @map("hostel_type")
  status         HostelStatus @default(ACTIVE)
  address        String?
  city           String?
  contactPhone   String?      @map("contact_phone")
  contactEmail   String?      @map("contact_email")
  capacity       Int          @default(0)
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus              Campus?                    @relation(fields: [campusId], references: [id], onDelete: SetNull)
  buildings           HostelBuilding[]
  floors              HostelFloor[]
  rooms               HostelRoom[]
  allocations         HostelAllocation[]
  attendances         HostelAttendance[]
  wardens             HostelWarden[]
  outings             HostelOuting[]
  visitors            HostelVisitor[]
  incidents           HostelIncident[]
  maintenanceRequests HostelMaintenanceRequest[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([campusId])
  @@map("hostels")
}

model HostelBuilding {
  id       String       @id @default(uuid())
  hostelId String       @map("hostel_id")
  name     String
  code     String
  capacity Int          @default(0)
  status   RecordStatus @default(ACTIVE)
  notes    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  hostel              Hostel                     @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  floors              HostelFloor[]
  rooms               HostelRoom[]
  allocations         HostelAllocation[]
  wardens             HostelWarden[]
  incidents           HostelIncident[]
  maintenanceRequests HostelMaintenanceRequest[]

  @@unique([hostelId, code])
  @@index([hostelId])
  @@map("hostel_buildings")
}

model HostelFloor {
  id          String       @id @default(uuid())
  hostelId    String       @map("hostel_id")
  buildingId  String?      @map("building_id")
  floorNumber Int          @map("floor_number")
  name        String
  status      RecordStatus @default(ACTIVE)
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  hostel      Hostel             @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  building    HostelBuilding?    @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  rooms       HostelRoom[]
  allocations HostelAllocation[]

  @@unique([hostelId, floorNumber])
  @@index([hostelId])
  @@index([buildingId])
  @@map("hostel_floors")
}

model HostelRoom {
  id                String                  @id @default(uuid())
  hostelId          String                  @map("hostel_id")
  buildingId        String?                 @map("building_id")
  floorId           String?                 @map("floor_id")
  roomNumber        String                  @map("room_number")
  name              String?
  roomType          HostelRoomType          @default(SHARED_ROOM) @map("room_type")
  genderEligibility HostelGenderEligibility @default(ANY) @map("gender_eligibility")
  capacity          Int                     @default(1)
  status            HostelRoomStatus        @default(AVAILABLE)
  facilities        String[]                @default([])
  feeAmount         Decimal?                @map("fee_amount") @db.Decimal(10, 2)
  feeStructureId    String?                 @map("fee_structure_id")
  notes             String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  hostel              Hostel                     @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  building            HostelBuilding?            @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  floor               HostelFloor?               @relation(fields: [floorId], references: [id], onDelete: SetNull)
  beds                HostelBed[]
  allocations         HostelAllocation[]
  attendances         HostelAttendance[]
  incidents           HostelIncident[]
  maintenanceRequests HostelMaintenanceRequest[]

  @@unique([hostelId, roomNumber])
  @@index([hostelId, status])
  @@index([buildingId])
  @@index([floorId])
  @@map("hostel_rooms")
}

model HostelBed {
  id        String          @id @default(uuid())
  roomId    String          @map("room_id")
  bedNumber String          @map("bed_number")
  status    HostelBedStatus @default(AVAILABLE)
  condition CopyCondition   @default(GOOD)
  notes     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  room        HostelRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  allocations HostelAllocation[]

  @@unique([roomId, bedNumber])
  @@index([roomId, status])
  @@map("hostel_beds")
}

model HostelAllocation {
  id               String                 @id @default(uuid())
  organizationId   String                 @map("organization_id")
  allocationNumber String                 @unique @map("allocation_number")
  studentId        String                 @map("student_id")
  hostelId         String                 @map("hostel_id")
  buildingId       String?                @map("building_id")
  floorId          String?                @map("floor_id")
  roomId           String                 @map("room_id")
  bedId            String?                @map("bed_id")
  academicYearId   String?                @map("academic_year_id")
  allocationDate   DateTime               @default(now()) @map("allocation_date")
  effectiveFrom    DateTime               @map("effective_from")
  effectiveTo      DateTime?              @map("effective_to")
  status           HostelAllocationStatus @default(RESERVED)
  checkInDate      DateTime?              @map("check_in_date")
  checkInNotes     String?                @map("check_in_notes")
  checkOutDate     DateTime?              @map("check_out_date")
  checkOutReason   String?                @map("check_out_reason")
  checkOutNotes    String?                @map("check_out_notes")
  allocatedBy      String?                @map("allocated_by")
  checkedInBy      String?                @map("checked_in_by")
  checkedOutBy     String?                @map("checked_out_by")
  isOverride       Boolean                @default(false) @map("is_override")
  overrideReason   String?                @map("override_reason")
  notes            String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hostel       Hostel          @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  building     HostelBuilding? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  floor        HostelFloor?    @relation(fields: [floorId], references: [id], onDelete: SetNull)
  room         HostelRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bed          HostelBed?      @relation(fields: [bedId], references: [id], onDelete: SetNull)
  academicYear AcademicYear?   @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  @@index([studentId, status])
  @@index([roomId, status])
  @@index([hostelId, status])
  @@index([organizationId, status])
  @@map("hostel_allocations")
}

model HostelAttendance {
  id             String                 @id @default(uuid())
  organizationId String                 @map("organization_id")
  hostelId       String                 @map("hostel_id")
  studentId      String                 @map("student_id")
  roomId         String?                @map("room_id")
  date           DateTime               @map("date")
  session        String                 @default("NIGHT_ROLL_CALL")
  status         HostelAttendanceStatus @default(PRESENT)
  recordedBy     String?                @map("recorded_by")
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hostel       Hostel         @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  room         HostelRoom?    @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([studentId, date, session])
  @@index([hostelId, date])
  @@index([organizationId, date])
  @@map("hostel_attendances")
}

model HostelWarden {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  employeeId     String          @map("employee_id")
  hostelId       String          @map("hostel_id")
  buildingId     String?         @map("building_id")
  role           HostelStaffRole @default(WARDEN)
  startDate      DateTime        @default(now()) @map("start_date")
  endDate        DateTime?       @map("end_date")
  status         RecordStatus    @default(ACTIVE)
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  hostel       Hostel          @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  building     HostelBuilding? @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  @@index([hostelId, status])
  @@index([employeeId, status])
  @@map("hostel_wardens")
}

model HostelOuting {
  id              String             @id @default(uuid())
  organizationId  String             @map("organization_id")
  outingNumber    String             @unique @map("outing_number")
  studentId       String             @map("student_id")
  hostelId        String             @map("hostel_id")
  outingType      HostelOutingType   @default(DAY_OUTING) @map("outing_type")
  startDate       DateTime           @map("start_date")
  expectedReturn  DateTime           @map("expected_return")
  actualReturn    DateTime?          @map("actual_return")
  destination     String?
  reason          String
  guardianConsent Boolean            @default(false) @map("guardian_consent")
  guardianContact String?            @map("guardian_contact")
  status          HostelOutingStatus @default(SUBMITTED)
  approvedBy      String?            @map("approved_by")
  approvalNotes   String?            @map("approval_notes")
  recordedBy      String?            @map("recorded_by")
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hostel       Hostel         @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([hostelId, status])
  @@index([organizationId, startDate])
  @@map("hostel_outings")
}

model HostelVisitor {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  visitorNumber  String              @unique @map("visitor_number")
  studentId      String              @map("student_id")
  hostelId       String              @map("hostel_id")
  visitorName    String              @map("visitor_name")
  relationship   String?
  contactPhone   String?             @map("contact_phone")
  idProofType    String?             @map("id_proof_type")
  idProofNumber  String?             @map("id_proof_number")
  visitDate      DateTime            @map("visit_date")
  purpose        String
  entryTime      DateTime?           @map("entry_time")
  exitTime       DateTime?           @map("exit_time")
  status         HostelVisitorStatus @default(SCHEDULED)
  approvedBy     String?             @map("approved_by")
  recordedBy     String?             @map("recorded_by")
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hostel       Hostel         @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  @@index([studentId, visitDate])
  @@index([hostelId, visitDate])
  @@map("hostel_visitors")
}

model HostelIncident {
  id              String               @id @default(uuid())
  organizationId  String               @map("organization_id")
  incidentNumber  String               @unique @map("incident_number")
  incidentDate    DateTime             @map("incident_date")
  hostelId        String               @map("hostel_id")
  buildingId      String?              @map("building_id")
  roomId          String?              @map("room_id")
  category        String
  description     String
  severity        IncidentSeverity     @default(LOW)
  immediateAction String?              @map("immediate_action")
  followUp        String?              @map("follow_up")
  status          HostelIncidentStatus @default(OPEN)
  reportedBy      String?              @map("reported_by")
  reviewedBy      String?              @map("reviewed_by")
  resolvedAt      DateTime?            @map("resolved_at")
  resolvedBy      String?              @map("resolved_by")
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hostel           Hostel                  @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  building         HostelBuilding?         @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  room             HostelRoom?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  involvedStudents HostelIncidentStudent[]

  @@index([hostelId, incidentDate])
  @@index([organizationId, status])
  @@map("hostel_incidents")
}

model HostelIncidentStudent {
  id         String  @id @default(uuid())
  incidentId String  @map("incident_id")
  studentId  String  @map("student_id")
  role       String?
  notes      String?

  incident HostelIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  student  StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, studentId])
  @@map("hostel_incident_students")
}

model HostelMaintenanceRequest {
  id             String                    @id @default(uuid())
  organizationId String                    @map("organization_id")
  requestNumber  String                    @unique @map("request_number")
  hostelId       String                    @map("hostel_id")
  buildingId     String?                   @map("building_id")
  roomId         String?                   @map("room_id")
  issueCategory  String                    @map("issue_category")
  description    String
  priority       HostelMaintenancePriority @default(MEDIUM)
  status         HostelMaintenanceStatus   @default(OPEN)
  reportedBy     String?                   @map("reported_by")
  assignedToId   String?                   @map("assigned_to_id")
  scheduledDate  DateTime?                 @map("scheduled_date")
  completedDate  DateTime?                 @map("completed_date")
  cost           Decimal?                  @db.Decimal(10, 2)
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hostel       Hostel           @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  building     HostelBuilding?  @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  room         HostelRoom?      @relation(fields: [roomId], references: [id], onDelete: SetNull)
  assignedTo   EmployeeProfile? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([hostelId, status])
  @@index([organizationId, status])
  @@map("hostel_maintenance_requests")
}

// ------------------------------------------------------------------------------
// Phase 4L: Inventory & Procurement Enums
// ------------------------------------------------------------------------------

enum InventoryItemStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum InventoryMovementType {
  OPENING
  RECEIPT
  ISSUE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN
  DAMAGE
  LOSS
  DISPOSAL
}

enum StockTransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum StockTakeStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum PurchaseRequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CONVERTED_TO_PO
  CANCELLED
  ORDERED
  FULFILLED
}

enum QuotationStatus {
  RECEIVED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  CLOSED
}

enum GoodsReceiptStatus {
  DRAFT
  COMPLETED
  REJECTED
  CANCELLED
}

enum SupplierInvoiceRefStatus {
  RECORDED
  VERIFIED
  SUBMITTED_TO_FINANCE
  SENT_TO_FINANCE
  CANCELLED
}

enum AdjustmentReason {
  COUNT_CORRECTION
  AUDIT_CORRECTION
  DAMAGE
  DAMAGED
  LOSS
  LOST
  FOUND
  EXPIRY
  EXPIRED
  DATA_CORRECTION
  SCRAP
  OTHER
}

enum StoreStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

// ------------------------------------------------------------------------------
// Phase 4L: Inventory Models
// ------------------------------------------------------------------------------

model InventoryCategory {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  code           String       @unique
  description    String?
  parentId       String?      @map("parent_id")
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       InventoryCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     InventoryCategory[] @relation("CategoryHierarchy")
  items        InventoryItem[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("inventory_categories")
}

model UnitOfMeasure {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  code           String       @unique
  symbol         String?
  status         RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        InventoryItem[]

  @@unique([organizationId, code])
  @@map("units_of_measure")
}

model InventoryItem {
  id              String              @id @default(uuid())
  organizationId  String              @map("organization_id")
  itemCode        String              @unique @map("item_code")
  name            String
  description     String?
  categoryId      String              @map("category_id")
  uomId           String              @map("uom_id")
  brand           String?
  barcode         String?
  reorderLevel    Decimal             @default(0) @map("reorder_level") @db.Decimal(10, 2)
  reorderQuantity Decimal             @default(0) @map("reorder_quantity") @db.Decimal(10, 2)
  minStock        Decimal             @default(0) @map("min_stock") @db.Decimal(10, 2)
  maxStock        Decimal?            @map("max_stock") @db.Decimal(10, 2)
  unitCost        Decimal             @default(0) @map("unit_cost") @db.Decimal(10, 2)
  trackBatch      Boolean             @default(false) @map("track_batch")
  trackSerial     Boolean             @default(false) @map("track_serial")
  trackExpiry     Boolean             @default(false) @map("track_expiry")
  status          InventoryItemStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       InventoryCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  uom            UnitOfMeasure           @relation(fields: [uomId], references: [id], onDelete: Cascade)
  balances       InventoryBalance[]
  movements      InventoryMovement[]
  transferLines  InventoryTransferLine[]
  stockTakeLines StockTakeLine[]
  requestLines   PurchaseRequestLine[]
  orderLines     PurchaseOrderLine[]
  receiptLines   GoodsReceiptLine[]

  @@unique([organizationId, itemCode])
  @@index([organizationId, status])
  @@index([categoryId])
  @@map("inventory_items")
}

model Store {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  campusId       String?     @map("campus_id")
  name           String
  code           String      @unique
  address        String?
  managerId      String?     @map("manager_id")
  status         StoreStatus @default(ACTIVE)
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus?             @relation(fields: [campusId], references: [id], onDelete: SetNull)
  manager        EmployeeProfile?    @relation(fields: [managerId], references: [id], onDelete: SetNull)
  locations      StorageLocation[]
  balances       InventoryBalance[]
  movements      InventoryMovement[]
  transfersFrom  InventoryTransfer[] @relation("TransferFromStore")
  transfersTo    InventoryTransfer[] @relation("TransferToStore")
  stockTakes     StockTake[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("stores")
}

model StorageLocation {
  id      String       @id @default(uuid())
  storeId String       @map("store_id")
  name    String
  code    String
  zone    String?
  rack    String?
  shelf   String?
  bin     String?
  status  RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store     Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@unique([storeId, code])
  @@map("storage_locations")
}

model InventoryBalance {
  id                String   @id @default(uuid())
  storeId           String   @map("store_id")
  itemId            String   @map("item_id")
  quantityOnHand    Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(12, 2)
  quantityReserved  Decimal  @default(0) @map("quantity_reserved") @db.Decimal(12, 2)
  quantityAvailable Decimal  @default(0) @map("quantity_available") @db.Decimal(12, 2)
  updatedAt         DateTime @updatedAt @map("updated_at")

  store Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  item  InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([storeId, itemId])
  @@index([storeId])
  @@index([itemId])
  @@map("inventory_balances")
}

model InventoryMovement {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  movementNumber String                @unique @map("movement_number")
  itemId         String                @map("item_id")
  storeId        String                @map("store_id")
  locationId     String?               @map("location_id")
  movementType   InventoryMovementType @map("movement_type")
  quantity       Decimal               @db.Decimal(12, 2)
  unitCost       Decimal?              @map("unit_cost") @db.Decimal(10, 2)
  totalCost      Decimal?              @map("total_cost") @db.Decimal(12, 2)
  reference      String?
  batchNumber    String?               @map("batch_number")
  serialNumber   String?               @map("serial_number")
  sourceDocument String?               @map("source_document")
  recipient      String?
  notes          String?
  recordedBy     String?               @map("recorded_by")
  movementDate   DateTime              @default(now()) @map("movement_date")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         InventoryItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  store        Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  location     StorageLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([organizationId, movementDate])
  @@index([itemId, storeId])
  @@index([movementType])
  @@map("inventory_movements")
}

model InventoryTransfer {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  transferNumber String              @unique @map("transfer_number")
  fromStoreId    String              @map("from_store_id")
  toStoreId      String              @map("to_store_id")
  transferDate   DateTime            @default(now()) @map("transfer_date")
  status         StockTransferStatus @default(PENDING)
  requestedBy    String?             @map("requested_by")
  approvedBy     String?             @map("approved_by")
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromStore    Store                   @relation("TransferFromStore", fields: [fromStoreId], references: [id], onDelete: Cascade)
  toStore      Store                   @relation("TransferToStore", fields: [toStoreId], references: [id], onDelete: Cascade)
  lines        InventoryTransferLine[]

  @@index([organizationId, status])
  @@map("inventory_transfers")
}

model InventoryTransferLine {
  id         String  @id @default(uuid())
  transferId String  @map("transfer_id")
  itemId     String  @map("item_id")
  quantity   Decimal @db.Decimal(12, 2)
  notes      String?

  transfer InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("inventory_transfer_lines")
}

model StockTake {
  id              String          @id @default(uuid())
  organizationId  String          @map("organization_id")
  stockTakeNumber String          @unique @map("stock_take_number")
  storeId         String          @map("store_id")
  countDate       DateTime        @default(now()) @map("count_date")
  status          StockTakeStatus @default(DRAFT)
  conductedBy     String?         @map("conducted_by")
  approvedBy      String?         @map("approved_by")
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  lines        StockTakeLine[]

  @@index([organizationId, status])
  @@map("stock_takes")
}

model StockTakeLine {
  id              String  @id @default(uuid())
  stockTakeId     String  @map("stock_take_id")
  itemId          String  @map("item_id")
  systemQuantity  Decimal @map("system_quantity") @db.Decimal(12, 2)
  countedQuantity Decimal @map("counted_quantity") @db.Decimal(12, 2)
  variance        Decimal @db.Decimal(12, 2)
  notes           String?

  stockTake StockTake     @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("stock_take_lines")
}

// ------------------------------------------------------------------------------
// Phase 4L: Procurement Models
// ------------------------------------------------------------------------------

model Supplier {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  supplierCode   String         @unique @map("supplier_code")
  name           String
  contactPerson  String?        @map("contact_person")
  phone          String?
  email          String?
  address        String?
  taxId          String?        @map("tax_id")
  categories     String[]       @default([])
  status         SupplierStatus @default(ACTIVE)
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  supplierInvoices SupplierInvoiceReference[]

  @@unique([organizationId, supplierCode])
  @@index([organizationId, status])
  @@map("suppliers")
}

model PurchaseRequest {
  id             String                  @id @default(uuid())
  organizationId String                  @map("organization_id")
  campusId       String?                 @map("campus_id")
  requestNumber  String                  @unique @map("request_number")
  requesterId    String?                 @map("requester_id")
  department     String?
  requiredDate   DateTime?               @map("required_date")
  purpose        String
  priority       PurchaseRequestPriority @default(MEDIUM)
  status         PurchaseRequestStatus   @default(SUBMITTED)
  approvedBy     String?                 @map("approved_by")
  approvalDate   DateTime?               @map("approval_date")
  approvalNotes  String?                 @map("approval_notes")
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus?               @relation(fields: [campusId], references: [id], onDelete: SetNull)
  requester      EmployeeProfile?      @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  lines          PurchaseRequestLine[]
  purchaseOrders PurchaseOrder[]

  @@index([organizationId, status])
  @@map("purchase_requests")
}

model PurchaseRequestLine {
  id                 String   @id @default(uuid())
  requestId          String   @map("request_id")
  itemId             String?  @map("item_id")
  itemDescription    String   @map("item_description")
  quantity           Decimal  @db.Decimal(12, 2)
  estimatedUnitPrice Decimal? @map("estimated_unit_price") @db.Decimal(10, 2)
  estimatedTotal     Decimal? @map("estimated_total") @db.Decimal(12, 2)
  notes              String?

  request PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item    InventoryItem?  @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@map("purchase_request_lines")
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  organizationId       String              @map("organization_id")
  campusId             String?             @map("campus_id")
  poNumber             String              @unique @map("po_number")
  supplierId           String              @map("supplier_id")
  storeId              String?             @map("store_id")
  purchaseRequestId    String?             @map("purchase_request_id")
  orderDate            DateTime            @default(now()) @map("order_date")
  expectedDeliveryDate DateTime?           @map("expected_delivery_date")
  terms                String?
  subtotal             Decimal             @default(0) @db.Decimal(12, 2)
  taxAmount            Decimal             @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount       Decimal             @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount          Decimal             @default(0) @map("total_amount") @db.Decimal(12, 2)
  status               PurchaseOrderStatus @default(DRAFT)
  approvedBy           String?             @map("approved_by")
  approvalDate         DateTime?           @map("approval_date")
  notes                String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus           Campus?                    @relation(fields: [campusId], references: [id], onDelete: SetNull)
  supplier         Supplier                   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  store            Store?                     @relation(fields: [storeId], references: [id], onDelete: SetNull)
  purchaseRequest  PurchaseRequest?           @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  lines            PurchaseOrderLine[]
  goodsReceipts    GoodsReceipt[]
  supplierInvoices SupplierInvoiceReference[]

  @@index([organizationId, status])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String  @id @default(uuid())
  orderId          String  @map("order_id")
  itemId           String? @map("item_id")
  itemDescription  String  @map("item_description")
  orderedQuantity  Decimal @map("ordered_quantity") @db.Decimal(12, 2)
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(12, 2)
  unitPrice        Decimal @map("unit_price") @db.Decimal(10, 2)
  taxRate          Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  totalPrice       Decimal @map("total_price") @db.Decimal(12, 2)
  notes            String?

  order PurchaseOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id                 String             @id @default(uuid())
  organizationId     String             @map("organization_id")
  receiptNumber      String             @unique @map("receipt_number")
  purchaseOrderId    String             @map("purchase_order_id")
  supplierId         String             @map("supplier_id")
  storeId            String             @map("store_id")
  receivedDate       DateTime           @default(now()) @map("received_date")
  receivedBy         String?            @map("received_by")
  deliveryNoteNumber String?            @map("delivery_note_number")
  status             GoodsReceiptStatus @default(COMPLETED)
  notes              String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder    PurchaseOrder              @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supplier         Supplier                   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  store            Store                      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  lines            GoodsReceiptLine[]
  supplierInvoices SupplierInvoiceReference[]

  @@index([organizationId, receivedDate])
  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id               String  @id @default(uuid())
  receiptId        String  @map("receipt_id")
  itemId           String? @map("item_id")
  itemDescription  String  @map("item_description")
  orderedQuantity  Decimal @map("ordered_quantity") @db.Decimal(12, 2)
  receivedQuantity Decimal @map("received_quantity") @db.Decimal(12, 2)
  rejectedQuantity Decimal @default(0) @map("rejected_quantity") @db.Decimal(12, 2)
  acceptedQuantity Decimal @map("accepted_quantity") @db.Decimal(12, 2)
  damageNotes      String? @map("damage_notes")
  batchNumber      String? @map("batch_number")
  serialNumber     String? @map("serial_number")

  receipt GoodsReceipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  item    InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@map("goods_receipt_lines")
}

model SupplierInvoiceReference {
  id              String                   @id @default(uuid())
  organizationId  String                   @map("organization_id")
  referenceNumber String                   @unique @map("reference_number")
  invoiceNumber   String                   @map("invoice_number")
  invoiceDate     DateTime                 @map("invoice_date")
  supplierId      String                   @map("supplier_id")
  purchaseOrderId String?                  @map("purchase_order_id")
  goodsReceiptId  String?                  @map("goods_receipt_id")
  amount          Decimal                  @db.Decimal(12, 2)
  currency        String                   @default("USD")
  status          SupplierInvoiceRefStatus @default(RECORDED)
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceipt  GoodsReceipt?  @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)

  @@unique([supplierId, invoiceNumber])
  @@index([organizationId, status])
  @@map("supplier_invoice_references")
}

// ------------------------------------------------------------------------------
// Phase 4M: Communication & Notification Enums
// ------------------------------------------------------------------------------

enum CommunicationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

enum CommunicationStatus {
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  FAILED
  RETRYING
  CANCELLED
  SKIPPED
  NOT_CONFIGURED
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  EXPIRED
  ARCHIVED
}

enum CommunicationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TemplateLanguage {
  EN
  UR
  AR
  OTHER
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
  DESKTOP
}

enum AudienceType {
  ALL
  ROLES
  CAMPUS
  CLASS_SECTION
  DEPARTMENT
  CUSTOM
  INDIVIDUAL
}

// ------------------------------------------------------------------------------
// Phase 4M: Communication & Notification Models
// ------------------------------------------------------------------------------

model Announcement {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  campusId       String?               @map("campus_id")
  code           String                @unique
  title          String
  content        String
  category       String                @default("GENERAL")
  priority       CommunicationPriority @default(NORMAL)
  status         AnnouncementStatus    @default(DRAFT)
  audienceType   AudienceType          @default(ALL) @map("audience_type")
  targetRoles    String[]              @default([]) @map("target_roles")
  targetGrades   String[]              @default([]) @map("target_grades")
  authorId       String                @map("author_id")
  publishedAt    DateTime?             @map("published_at")
  scheduledFor   DateTime?             @map("scheduled_for")
  expiresAt      DateTime?             @map("expires_at")
  attachments    String[]              @default([])
  viewsCount     Int                   @default(0) @map("views_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@map("announcements")
}

model CommunicationTemplate {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  code           String               @unique
  name           String
  description    String?
  channel        CommunicationChannel @default(IN_APP)
  language       TemplateLanguage     @default(EN)
  subject        String?
  body           String
  variables      String[]             @default([])
  currentVersion Int                  @default(1) @map("current_version")
  isActive       Boolean              @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     CommunicationTemplateVersion[]
  campaigns    CommunicationCampaign[]

  @@unique([organizationId, code, language])
  @@index([organizationId, channel])
  @@map("communication_templates")
}

model CommunicationTemplateVersion {
  id          String   @id @default(uuid())
  templateId  String   @map("template_id")
  version     Int
  subject     String?
  body        String
  variables   String[] @default([])
  changeNotes String?  @map("change_notes")
  changedBy   String?  @map("changed_by")
  createdAt   DateTime @default(now()) @map("created_at")

  template CommunicationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@map("communication_template_versions")
}

model CommunicationCampaign {
  id              String                 @id @default(uuid())
  organizationId  String                 @map("organization_id")
  campusId        String?                @map("campus_id")
  code            String                 @unique
  title           String
  description     String?
  eventType       String?                @map("event_type")
  channels        CommunicationChannel[] @default([IN_APP])
  templateId      String?                @map("template_id")
  audienceType    AudienceType           @default(ROLES) @map("audience_type")
  audienceFilter  Json?                  @map("audience_filter")
  status          CommunicationStatus    @default(QUEUED)
  priority        CommunicationPriority  @default(NORMAL)
  scheduledAt     DateTime?              @map("scheduled_at")
  sentAt          DateTime?              @map("sent_at")
  totalRecipients Int                    @default(0) @map("total_recipients")
  sentCount       Int                    @default(0) @map("sent_count")
  deliveredCount  Int                    @default(0) @map("delivered_count")
  failedCount     Int                    @default(0) @map("failed_count")
  skippedCount    Int                    @default(0) @map("skipped_count")
  createdBy       String?                @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?                 @relation(fields: [campusId], references: [id], onDelete: SetNull)
  template     CommunicationTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  deliveries   CommunicationDelivery[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("communication_campaigns")
}

model CommunicationDelivery {
  id             String               @id @default(uuid())
  campaignId     String?              @map("campaign_id")
  userId         String?              @map("user_id")
  recipient      String
  recipientName  String?              @map("recipient_name")
  channel        CommunicationChannel
  provider       String               @default("internal")
  status         CommunicationStatus  @default(QUEUED)
  subject        String?
  contentSnippet String?              @map("content_snippet")
  attempts       Int                  @default(0)
  maxAttempts    Int                  @default(3) @map("max_attempts")
  lastAttemptAt  DateTime?            @map("last_attempt_at")
  deliveredAt    DateTime?            @map("delivered_at")
  failureReason  String?              @map("failure_reason")
  providerRef    String?              @map("provider_ref")
  idempotencyKey String               @unique @map("idempotency_key")
  createdAt      DateTime             @default(now()) @map("created_at")

  campaign CommunicationCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([recipient, channel])
  @@index([status])
  @@map("communication_deliveries")
}

model CommunicationAudience {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  code           String       @unique
  description    String?
  audienceType   AudienceType @default(ROLES) @map("audience_type")
  filterCriteria Json         @map("filter_criteria")
  isDynamic      Boolean      @default(true) @map("is_dynamic")
  isActive       Boolean      @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@map("communication_audiences")
}

model CommunicationPreference {
  id              String               @id @default(uuid())
  userId          String               @map("user_id")
  channel         CommunicationChannel
  category        String               @default("ALL")
  isEnabled       Boolean              @default(true) @map("is_enabled")
  quietHoursStart String?              @map("quiet_hours_start")
  quietHoursEnd   String?              @map("quiet_hours_end")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, category])
  @@index([userId])
  @@map("communication_preferences")
}

model DeviceRegistration {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  deviceToken  String         @unique @map("device_token")
  platform     DevicePlatform @default(WEB)
  deviceName   String?        @map("device_name")
  isActive     Boolean        @default(true) @map("is_active")
  lastActiveAt DateTime       @default(now()) @map("last_active_at")
  createdAt    DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("device_registrations")
}

model CommunicationWebhookEvent {
  id              String    @id @default(uuid())
  provider        String
  providerEventId String?   @map("provider_event_id")
  eventType       String    @map("event_type")
  payload         Json
  isProcessed     Boolean   @default(false) @map("is_processed")
  processedAt     DateTime? @map("processed_at")
  errorMessage    String?   @map("error_message")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([provider, providerEventId])
  @@index([provider, isProcessed])
  @@map("communication_webhook_events")
}

// ==============================================================================
// Phase 4Q: Documents, Certificates & Printing Models
// ==============================================================================

enum DocumentLifecycleStatus {
  ACTIVE
  ARCHIVED
  EXPIRED
  REVOKED
  DELETED
}

enum DocumentSharePermission {
  VIEW
  DOWNLOAD
}

enum CertificateCategory {
  STUDENT
  EMPLOYEE
  GENERAL
}

enum CertificateLifecycleStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ISSUED
  REVOKED
  CANCELLED
}

enum CertificateLayout {
  PORTRAIT
  LANDSCAPE
}

enum PageSize {
  A4
  A5
  LETTER
}

enum DocumentGenerationJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model DocumentCategory {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  code           String // STUDENT, EMPLOYEE, ACADEMIC, FINANCE, HR, LIBRARY, TRANSPORT, HOSTEL, PROCUREMENT, CERTIFICATE, ADMINISTRATIVE, OTHER
  name           String
  description    String?
  isSystem       Boolean      @default(false) @map("is_system")
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  documentTypes DocumentType[]
  documents     InstitutionalDocument[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("document_categories")
}

model DocumentType {
  id               String       @id @default(uuid())
  organizationId   String       @map("organization_id")
  categoryId       String       @map("category_id")
  code             String
  name             String
  description      String?
  allowedMimeTypes String[]     @map("allowed_mime_types")
  maxFileSizeMb    Int          @default(10) @map("max_file_size_mb")
  requiresExpiry   Boolean      @default(false) @map("requires_expiry")
  isSystem         Boolean      @default(false) @map("is_system")
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  category  DocumentCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  documents InstitutionalDocument[]

  @@unique([organizationId, code])
  @@index([organizationId, categoryId, status])
  @@map("document_types")
}

model InstitutionalDocument {
  id                    String                  @id @default(uuid())
  organizationId        String                  @map("organization_id")
  campusId              String?                 @map("campus_id")
  documentNumber        String                  @unique @map("document_number") // DOC-YYYY-XXXXX
  title                 String
  categoryId            String                  @map("category_id")
  typeId                String                  @map("type_id")
  fileKey               String                  @map("file_key")
  fileName              String                  @map("file_name")
  mimeType              String                  @map("mime_type")
  sizeInBytes           BigInt                  @map("size_in_bytes")
  fileHash              String?                 @map("file_hash") // SHA-256
  entityType            String?                 @map("entity_type") // STUDENT, EMPLOYEE, VEHICLE, INVOICE, PAYMENT, GENERAL, etc.
  entityId              String?                 @map("entity_id")
  ownerUserId           String?                 @map("owner_user_id")
  currentVersion        Int                     @default(1) @map("current_version")
  status                DocumentLifecycleStatus @default(ACTIVE)
  issueDate             DateTime?               @map("issue_date") @db.Date
  expiryDate            DateTime?               @map("expiry_date") @db.Date
  reminderThresholdDays Int?                    @map("reminder_threshold_days")
  isConfidential        Boolean                 @default(false) @map("is_confidential")
  notes                 String?
  uploadedBy            String?                 @map("uploaded_by")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  category     DocumentCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  documentType DocumentType      @relation(fields: [typeId], references: [id], onDelete: Restrict)
  versions     DocumentVersion[]
  shares       DocumentShare[]

  @@index([organizationId, categoryId, status])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, expiryDate])
  @@index([ownerUserId])
  @@map("institutional_documents")
}

model DocumentVersion {
  id            String   @id @default(uuid())
  documentId    String   @map("document_id")
  versionNumber Int      @map("version_number")
  fileKey       String   @map("file_key")
  fileName      String   @map("file_name")
  mimeType      String   @map("mime_type")
  sizeInBytes   BigInt   @map("size_in_bytes")
  fileHash      String?  @map("file_hash")
  changeSummary String?  @map("change_summary")
  uploadedBy    String?  @map("uploaded_by")
  createdAt     DateTime @default(now()) @map("created_at")

  document InstitutionalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("document_versions")
}

model DocumentShare {
  id               String                  @id @default(uuid())
  documentId       String                  @map("document_id")
  sharedWithUserId String?                 @map("shared_with_user_id")
  sharedWithRole   String?                 @map("shared_with_role")
  permission       DocumentSharePermission @default(VIEW)
  expiresAt        DateTime?               @map("expires_at")
  accessCount      Int                     @default(0) @map("access_count")
  createdBy        String?                 @map("created_by")
  createdAt        DateTime                @default(now()) @map("created_at")

  document InstitutionalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([sharedWithUserId])
  @@map("document_shares")
}

model CertificateType {
  id               String              @id @default(uuid())
  organizationId   String              @map("organization_id")
  code             String // BONAFIDE, CHARACTER, ENROLLMENT, TRANSFER, LEAVING, CONDUCT, EMPLOYMENT, SALARY, EXPERIENCE
  name             String
  category         CertificateCategory @default(STUDENT)
  requiresApproval Boolean             @default(false) @map("requires_approval")
  validityDays     Int?                @map("validity_days")
  description      String?
  status           RecordStatus        @default(ACTIVE)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  templates    CertificateTemplate[]
  certificates IssuedCertificate[]

  @@unique([organizationId, code])
  @@index([organizationId, category, status])
  @@map("certificate_types")
}

model CertificateTemplate {
  id                String       @id @default(uuid())
  organizationId    String       @map("organization_id")
  campusId          String?      @map("campus_id")
  certificateTypeId String       @map("certificate_type_id")
  name              String
  code              String
  currentVersion    Int          @default(1) @map("current_version")
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  certificateType CertificateType              @relation(fields: [certificateTypeId], references: [id], onDelete: Cascade)
  versions        CertificateTemplateVersion[]

  @@unique([organizationId, code])
  @@index([organizationId, certificateTypeId, status])
  @@map("certificate_templates")
}

model CertificateTemplateVersion {
  id                    String            @id @default(uuid())
  templateId            String            @map("template_id")
  versionNumber         Int               @map("version_number")
  layout                CertificateLayout @default(PORTRAIT)
  pageSize              PageSize          @default(A4) @map("page_size")
  htmlBody              String            @map("html_body")
  cssStyles             String?           @map("css_styles")
  headerConfig          Json?             @map("header_config")
  footerConfig          Json?             @map("footer_config")
  variables             String[]          @default([])
  signaturePlaceholders Json?             @map("signature_placeholders")
  isActive              Boolean           @default(true) @map("is_active")
  createdBy             String?           @map("created_by")
  createdAt             DateTime          @default(now()) @map("created_at")

  template           CertificateTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  issuedCertificates IssuedCertificate[]

  @@unique([templateId, versionNumber])
  @@index([templateId, isActive])
  @@map("certificate_template_versions")
}

model IssuedCertificate {
  id                    String                     @id @default(uuid())
  organizationId        String                     @map("organization_id")
  campusId              String?                    @map("campus_id")
  certificateNumber     String                     @unique @map("certificate_number") // CERT-YYYY-XXXXX
  verificationReference String                     @unique @map("verification_reference") // cryptographic UUID / token
  certificateTypeId     String                     @map("certificate_type_id")
  templateVersionId     String                     @map("template_version_id")
  entityType            CertificateCategory        @default(STUDENT) @map("entity_type")
  entityId              String                     @map("entity_id")
  recipientName         String                     @map("recipient_name")
  issuedDate            DateTime                   @default(now()) @map("issued_date") @db.Date
  expiryDate            DateTime?                  @map("expiry_date") @db.Date
  status                CertificateLifecycleStatus @default(ISSUED)
  approvalStatus        String?                    @map("approval_status") // PENDING, APPROVED, REJECTED
  approvedBy            String?                    @map("approved_by")
  approvedAt            DateTime?                  @map("approved_at")
  issuedBy              String?                    @map("issued_by")
  revocationReason      String?                    @map("revocation_reason")
  revokedBy             String?                    @map("revoked_by")
  revokedAt             DateTime?                  @map("revoked_at")
  metadata              Json? // Snapshot of interpolated data variables
  qrCodeUrl             String?                    @map("qr_code_url")
  pdfFileKey            String?                    @map("pdf_file_key")
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")

  certificateType CertificateType            @relation(fields: [certificateTypeId], references: [id], onDelete: Restrict)
  templateVersion CertificateTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([entityId, entityType])
  @@index([certificateNumber])
  @@index([verificationReference])
  @@map("issued_certificates")
}

model DocumentGenerationJob {
  id             String                      @id @default(uuid())
  organizationId String                      @map("organization_id")
  campusId       String?                     @map("campus_id")
  jobType        String                      @map("job_type") // CERTIFICATE, REPORT_CARD, TRANSCRIPT, FEE_RECEIPT, INVOICE, PAYSLIP, ATTENDANCE_SHEET, BULK_CERTIFICATES
  status         DocumentGenerationJobStatus @default(PENDING)
  totalItems     Int                         @default(0) @map("total_items")
  processedItems Int                         @default(0) @map("processed_items")
  failedItems    Int                         @default(0) @map("failed_items")
  payload        Json?
  resultSummary  Json?                       @map("result_summary")
  errorDetails   String?                     @map("error_details")
  requestedBy    String?                     @map("requested_by")
  createdAt      DateTime                    @default(now()) @map("created_at")
  completedAt    DateTime?                   @map("completed_at")

  @@index([organizationId, status])
  @@map("document_generation_jobs")
}

// =============================================================================
// Phase 4R: Reports, Analytics & Dashboards Models
// =============================================================================

model SavedReport {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  campusId       String?  @map("campus_id")
  userId         String   @map("user_id")
  reportKey      String   @map("report_key")
  name           String
  description    String?
  category       String // STUDENTS, ACADEMICS, ATTENDANCE, EXAMINATIONS, FINANCE, HR, LIBRARY, TRANSPORT, HOSTEL, INVENTORY, COMMUNICATION, DOCUMENTS
  filters        Json     @default("{}")
  displayColumns Json?    @map("display_columns")
  sortConfig     Json?    @map("sort_config")
  isPublic       Boolean  @default(false) @map("is_public")
  isFavorite     Boolean  @default(false) @map("is_favorite")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId, category])
  @@index([userId, isFavorite])
  @@map("saved_reports")
}

model ScheduledReport {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  campusId       String?   @map("campus_id")
  userId         String    @map("user_id")
  savedReportId  String?   @map("saved_report_id")
  reportKey      String    @map("report_key")
  name           String
  cronExpression String    @map("cron_expression") // e.g. "0 8 * * 1"
  frequency      String    @default("WEEKLY") // DAILY, WEEKLY, MONTHLY, TERMLY
  format         String    @default("CSV") // CSV, XLSX, PDF
  filters        Json      @default("{}")
  recipients     Json      @default("[]") // string[]
  channel        String    @default("EMAIL") // EMAIL, IN_APP, NOTIFICATION
  isActive       Boolean   @default(true) @map("is_active")
  lastRunAt      DateTime? @map("last_run_at")
  nextRunAt      DateTime? @map("next_run_at")
  lastRunStatus  String?   @map("last_run_status") // SUCCESS, FAILED
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([organizationId, isActive])
  @@map("scheduled_reports")
}

model ReportExecutionLog {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  campusId        String?  @map("campus_id")
  userId          String?  @map("user_id")
  reportKey       String   @map("report_key")
  reportName      String   @map("report_name")
  category        String
  filters         Json?
  format          String   @default("JSON") // JSON, CSV, XLSX, PDF
  rowCount        Int      @default(0) @map("row_count")
  executionTimeMs Int      @default(0) @map("execution_time_ms")
  status          String   @default("SUCCESS") // SUCCESS, FAILED, TIMED_OUT
  errorMessage    String?  @map("error_message")
  fileKey         String?  @map("file_key")
  fileSize        Int?     @map("file_size")
  isScheduled     Boolean  @default(false) @map("is_scheduled")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([organizationId, reportKey])
  @@index([userId, createdAt])
  @@map("report_execution_logs")
}

model DashboardPreference {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  roleKey        String   @map("role_key") // PRINCIPAL, TEACHER, ACCOUNTANT, STUDENT, PARENT, HR_MANAGER, LIBRARIAN
  layoutConfig   Json     @default("{}") @map("layout_config")
  defaultFilters Json?    @map("default_filters")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, userId, roleKey])
  @@map("dashboard_preferences")
}

// ==============================================================================
// Phase 4S: Integrations & External Services Models
// ==============================================================================

model IntegrationConfig {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  campusId          String?   @map("campus_id")
  type              String // EMAIL, SMS, PUSH, WHATSAPP, PAYMENT, STORAGE, MAPS, CALENDAR, IDENTITY, DATA_EXCHANGE
  provider          String // SMTP, SENDGRID, SES, TWILIO, MESSAGEBIRD, FCM, META_WHATSAPP, STRIPE, RAZORPAY, S3, MINIO, etc.
  name              String
  description       String?
  environment       String    @default("SANDBOX") // SANDBOX, PRODUCTION
  isEnabled         Boolean   @default(false) @map("is_enabled")
  encryptedConfig   String    @map("encrypted_config") // Encrypted credentials & parameters
  maskedConfig      Json      @default("{}") @map("masked_config") // Redacted/masked view safe for frontend inspection
  healthStatus      String    @default("UNKNOWN") @map("health_status") // HEALTHY, DEGRADED, FAILING, NOT_CONFIGURED, DISABLED, UNKNOWN
  lastHealthCheckAt DateTime? @map("last_health_check_at")
  lastSuccessAt     DateTime? @map("last_success_at")
  lastFailureAt     DateTime? @map("last_failure_at")
  lastErrorMessage  String?   @map("last_error_message")
  failureCount      Int       @default(0) @map("failure_count")
  createdBy         String?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, campusId, type, provider])
  @@index([organizationId, type])
  @@index([organizationId, isEnabled])
  @@map("integration_configs")
}

model WebhookEventLog {
  id               String   @id @default(uuid())
  organizationId   String?  @map("organization_id")
  provider         String // STRIPE, RAZORPAY, TWILIO, WHATSAPP, GENERIC
  eventType        String   @map("event_type")
  eventId          String?  @map("event_id") // Provider unique event ID for strict idempotency
  payloadHash      String?  @map("payload_hash") // SHA-256 hash of payload
  signature        String?
  status           String   @default("RECEIVED") // RECEIVED, VERIFIED, PROCESSED, DUPLICATE, FAILED, IGNORED
  responseCode     Int?     @map("response_code")
  processingTimeMs Int?     @map("processing_time_ms")
  errorMessage     String?  @map("error_message")
  payload          Json? // Normalized event payload (sensitive payment card data omitted)
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([provider, eventId])
  @@index([provider, status])
  @@index([createdAt])
  @@map("webhook_event_logs")
}

model IntegrationLog {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  campusId        String?  @map("campus_id")
  integrationId   String?  @map("integration_id")
  type            String // EMAIL, SMS, PUSH, WHATSAPP, PAYMENT, etc.
  provider        String
  operation       String // SEND_EMAIL, SEND_SMS, INITIATE_PAYMENT, VERIFY_WEBHOOK, TEST_CONNECTION, etc.
  direction       String   @default("OUTBOUND") // OUTBOUND, INBOUND
  correlationId   String?  @map("correlation_id")
  externalRef     String?  @map("external_ref")
  status          String // SUCCESS, FAILED, RETRYING, TIMEOUT
  latencyMs       Int      @default(0) @map("latency_ms")
  retryCount      Int      @default(0) @map("retry_count")
  normalizedError String?  @map("normalized_error") // AUTHENTICATION_ERROR, RATE_LIMITED, etc.
  errorMessage    String?  @map("error_message")
  metadata        Json?    @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([type, provider])
  @@index([status])
  @@map("integration_logs")
}

model IntegrationOutbox {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  eventType      String    @map("event_type")
  aggregateType  String    @map("aggregate_type") // e.g. Payment, FeeInvoice, Notification
  aggregateId    String    @map("aggregate_id")
  payload        Json
  status         String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, DEAD_LETTER
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5) @map("max_attempts")
  nextRetryAt    DateTime? @map("next_retry_at")
  lastError      String?   @map("last_error")
  processedAt    DateTime? @map("processed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([status, nextRetryAt])
  @@index([organizationId, aggregateType, aggregateId])
  @@map("integration_outbox")
}

model DataExchangeJob {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  type           String // IMPORT, EXPORT
  entityType     String    @map("entity_type") // STUDENTS, EMPLOYEES, FEES, INVENTORY, BOOKS
  fileFormat     String    @map("file_format") // CSV, XLSX
  fileName       String    @map("file_name")
  fileKey        String?   @map("file_key")
  totalRows      Int       @default(0) @map("total_rows")
  processedRows  Int       @default(0) @map("processed_rows")
  successfulRows Int       @default(0) @map("successful_rows")
  failedRows     Int       @default(0) @map("failed_rows")
  status         String    @default("PENDING") // PENDING, VALIDATING, PROCESSING, COMPLETED, FAILED, PARTIAL
  errorDetails   Json?     @map("error_details") // Array of row-level error objects
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  @@index([organizationId, status])
  @@index([userId, createdAt])
  @@map("data_exchange_jobs")
}
