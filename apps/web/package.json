{
  "name": "@school/web",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise School Management System Web Portal (Next.js 16 App Router)",
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "pnpm --filter @school/shared-types build && pnpm --filter @school/validation build && pnpm --filter @school/api-client build",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "clean": "rimraf .next out dist"
  },
  "dependencies": {
    "@school/api-client": "workspace:*",
    "@school/shared-types": "workspace:*",
    "@school/validation": "workspace:*",
    "lucide-react": "^1.16.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2"
  }
}
